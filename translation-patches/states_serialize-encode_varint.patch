Translation patch: spqr::v1::chunked::states::serialize::encode_varint

Change: `break` (inside an `if`/`else` in the loop) becomes `return`, and the `else` is dropped.
Why: Aeneas does not translate this `break` inside the `for` loop.
Behaviour: identical (nothing follows the loop).

diff --git a/src/v1/chunked/states/serialize.rs b/src/v1/chunked/states/serialize.rs
index a13738c..3f6f738 100644
--- a/src/v1/chunked/states/serialize.rs
+++ b/src/v1/chunked/states/serialize.rs
@@ -139,14 +139,13 @@ fn from_payload(mp: &MessagePayload) -> Self {
 fn encode_varint(mut a: u64, into: &mut SerializedMessage) {
     for _i in 0..MAX_VARINT_BYTES_LEN {
         let byte = (a & 0x7F) as u8;
         if a < 0x80 {
             into.push(byte);
-            break;
-        } else {
-            into.push(0x80 | byte);
-            a >>= 7;
+            return;
         }
+        into.push(0x80 | byte);
+        a >>= 7;
     }
 }
 
 #[hax_lib::ensures(|res| *at <= *future(at) && if res.is_ok() { *at < from.len() && *future(at) <= from.len() } else { true })]
