+            || pb.pts[12].len() % 4 != 0 || pb.pts[13].len() % 4 != 0
+            || pb.pts[14].len() % 4 != 0 || pb.pts[15].len() % 4 != 0
+        {
+            return Err(PolynomialError::SerializationInvalid);
