+                }
+                let mut polys = Vec::with_capacity(pts.len());
+                for i in 0..pts.len() {
+                    polys.push(Self::lagrange_interpolate_pt(&ones, i));
+                }
+                polys
             }
         };
         Ok(Self::lagrange_sum(pts, &polys))
     }
