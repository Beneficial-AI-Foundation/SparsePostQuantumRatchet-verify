Translation patch: <GF16 as MulAssign<&GF16>>::mul_assign

Change: the hardware-accelerated branch is gated on `not(feature = "extraction")` instead of
`not(hax)`.
Why: the SIMD code (`gf::accelerated`, `gf::check_accelerated`) is excluded from the translation.
Behaviour: identical (the accelerated and portable multiplications compute the same product).

diff --git a/src/encoding/gf.rs b/src/encoding/gf.rs
index 3d78854..1f57b88 100644
--- a/src/encoding/gf.rs
+++ b/src/encoding/gf.rs
@@ -126,15 +126,15 @@ fn sub(self, other: &Self) -> Self {
 impl ops::MulAssign<&GF16> for GF16 {
     fn mul_assign(&mut self, other: &Self) {
         #[cfg(all(
-            not(hax),
+            not(feature = "extraction"),
             any(target_arch = "x86", target_arch = "x86_64", target_arch = "aarch64")
         ))]
         if check_accelerated::TOKEN.get() {
             self.value = accelerated::mul(self.value, other.value);
             return;
         }
         self.value = unaccelerated::mul(self.value, other.value);
     }
 }
 
 #[hax_lib::attributes]
