Translation patch: <spqr::v1::chunked::send_ek::HeaderSent>::from_pb

Change: the check
  `if let Some(..) = &pb.receiving_ct1 { if <cond> { return Err(Error::MsgDecode); } }`
becomes
  `if matches!(&pb.receiving_ct1, Some(..) if <cond>) { return Err(Error::MsgDecode); }`.
Why: Aeneas duplicates the rest of the function for the `None` case and emits a `none` literal
whose type Lean cannot infer ("The type of pattern variable ... contains metavariables",
aeneas#1018).
Behaviour: identical (same condition, same error, same order of checks).

diff --git a/src/v1/chunked/send_ek/serialize.rs b/src/v1/chunked/send_ek/serialize.rs
index 5e8f9dd..3211186 100644
--- a/src/v1/chunked/send_ek/serialize.rs
+++ b/src/v1/chunked/send_ek/serialize.rs
@@ -50,19 +50,20 @@ pub fn into_pb(self) -> pqrpb::v1_state::chunked::HeaderSent {
     }
 
     pub fn from_pb(pb: pqrpb::v1_state::chunked::HeaderSent) -> Result<Self, Error> {
-        if let Some(d) = &pb.receiving_ct1 {
-            if d.pts_needed as usize != crate::incremental_mlkem768::CIPHERTEXT1_SIZE / 2 {
-                return Err(Error::MsgDecode);
-            }
+        if matches!(
+            &pb.receiving_ct1,
+            Some(d) if d.pts_needed as usize != crate::incremental_mlkem768::CIPHERTEXT1_SIZE / 2
+        ) {
+            return Err(Error::MsgDecode);
         }
         Ok(Self {
             uc: unchunked::send_ek::EkSent::from_pb(pb.uc.ok_or(Error::StateDecode)?)?,
             sending_ek: polynomial::PolyEncoder::from_pb(pb.sending_ek.ok_or(Error::StateDecode)?)
                 .map_err(|_| Error::StateDecode)?,
             receiving_ct1: polynomial::PolyDecoder::from_pb(
                 pb.receiving_ct1.ok_or(Error::StateDecode)?,
             )
             .map_err(|_| Error::StateDecode)?,
         })
     }
 }
