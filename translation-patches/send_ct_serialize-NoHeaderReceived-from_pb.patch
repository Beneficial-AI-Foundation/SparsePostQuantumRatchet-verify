Translation patch: <spqr::v1::chunked::send_ct::NoHeaderReceived>::from_pb

Change: the check
  `if let Some(..) = &pb.receiving_hdr { if <cond> { return Err(Error::MsgDecode); } }`
becomes
  `if matches!(&pb.receiving_hdr, Some(..) if <cond>) { return Err(Error::MsgDecode); }`.
Why: Aeneas duplicates the rest of the function for the `None` case and emits a `none` literal
whose type Lean cannot infer ("The type of pattern variable ... contains metavariables",
aeneas#1018).
Behaviour: identical (same condition, same error, same order of checks).

diff --git a/src/v1/chunked/send_ct/serialize.rs b/src/v1/chunked/send_ct/serialize.rs
index 1da63b4..a3cfc5f 100644
--- a/src/v1/chunked/send_ct/serialize.rs
+++ b/src/v1/chunked/send_ct/serialize.rs
@@ -16,21 +16,21 @@ pub fn into_pb(self) -> pqrpb::v1_state::chunked::NoHeaderReceived {
     }
 
     pub fn from_pb(pb: pqrpb::v1_state::chunked::NoHeaderReceived) -> Result<Self, Error> {
-        if let Some(rhdr) = &pb.receiving_hdr {
-            if rhdr.pts_needed
+        if matches!(
+            &pb.receiving_hdr,
+            Some(rhdr) if rhdr.pts_needed
                 != ((crate::incremental_mlkem768::HEADER_SIZE
                     + crate::authenticator::Authenticator::MACSIZE)
                     / 2) as u32
-            {
-                return Err(Error::MsgDecode);
-            }
+        ) {
+            return Err(Error::MsgDecode);
         }
         Ok(Self {
             uc: unchunked::send_ct::NoHeaderReceived::from_pb(pb.uc.ok_or(Error::StateDecode)?)?,
             receiving_hdr: polynomial::PolyDecoder::from_pb(
                 pb.receiving_hdr.ok_or(Error::StateDecode)?,
             )
             .map_err(|_| Error::StateDecode)?,
         })
     }
 }
