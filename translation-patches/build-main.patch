Translation patch: build.rs main

Change: prost writes its output into `generated/` instead of `$OUT_DIR`.
Why: the translation records the source path of every generated item, and `$OUT_DIR` is an
absolute, per-build path, which would make the committed translation non-reproducible.
Behaviour: identical (it can panic if `generated/` cannot be created).
Relies on: pq_ratchet-include.patch includes the output from `generated/`.

diff --git a/build.rs b/build.rs
index b7797fe..46e7722 100644
--- a/build.rs
+++ b/build.rs
@@ -4,10 +4,13 @@
 fn main() {
     let protos = ["src/proto/pq_ratchet.proto"];
     let mut prost_build = prost_build::Config::new();
+    let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("generated");
+    std::fs::create_dir_all(&dir).expect("can create generated/");
+    prost_build.out_dir(dir);
     prost_build
         .compile_protos(&protos, &["src"])
         .expect("Protobufs in src are valid");
     for proto in &protos {
         println!("cargo:rerun-if-changed={proto}");
     }
 }
