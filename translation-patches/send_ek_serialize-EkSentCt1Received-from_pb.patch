Translation patch: <spqr::v1::chunked::send_ek::EkSentCt1Received>::from_pb

Change: the check
  `if let Some(..) = &pb.receiving_ct2 { if <cond> { return Err(Error::MsgDecode); } }`
becomes
  `if matches!(&pb.receiving_ct2, Some(..) if <cond>) { return Err(Error::MsgDecode); }`.
Why: Aeneas duplicates the rest of the function for the `None` case and emits a `none` literal
whose type Lean cannot infer ("The type of pattern variable ... contains metavariables",
aeneas#1018).
Behaviour: identical (same condition, same error, same order of checks).

diff --git a/src/v1/chunked/send_ek/serialize.rs b/src/v1/chunked/send_ek/serialize.rs
index 5e8f9dd..219b9cc 100644
--- a/src/v1/chunked/send_ek/serialize.rs
+++ b/src/v1/chunked/send_ek/serialize.rs
@@ -93,20 +93,20 @@ pub fn into_pb(self) -> pqrpb::v1_state::chunked::EkSentCt1Received {
     }
 
     pub fn from_pb(pb: pqrpb::v1_state::chunked::EkSentCt1Received) -> Result<Self, Error> {
-        if let Some(d) = &pb.receiving_ct2 {
-            if d.pts_needed as usize
+        if matches!(
+            &pb.receiving_ct2,
+            Some(d) if d.pts_needed as usize
                 != (incremental_mlkem768::CIPHERTEXT2_SIZE + authenticator::Authenticator::MACSIZE)
                     / 2
-            {
-                return Err(Error::MsgDecode);
-            }
+        ) {
+            return Err(Error::MsgDecode);
         }
         Ok(Self {
             uc: unchunked::send_ek::EkSentCt1Received::from_pb(pb.uc.ok_or(Error::StateDecode)?)?,
             receiving_ct2: polynomial::PolyDecoder::from_pb(
                 pb.receiving_ct2.ok_or(Error::StateDecode)?,
             )
             .map_err(|_| Error::StateDecode)?,
         })
     }
 }
