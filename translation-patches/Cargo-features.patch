Translation patch: Cargo.toml [features]

Change: adds the feature `extraction`, enabled only by the translation (`--features extraction`).
Why: the other translation patches select translation-only code with `cfg(feature = "extraction")`.
Behaviour: identical (the feature is off in normal builds).

diff --git a/Cargo.toml b/Cargo.toml
index 96fde83..2367e92 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -40,6 +40,7 @@ prost-build = "0.14.1"
 [features]
 proof = []
 test-utils = []
+extraction = []
 
 [target.'cfg(any(target_arch = "aarch64", target_arch = "x86_64", target_arch = "x86"))'.dependencies]
 cpufeatures = "0.3"
