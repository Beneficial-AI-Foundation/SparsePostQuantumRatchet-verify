Translation patch: spqr::encoding::gf::mul2_u16

Change: the hardware-accelerated branch is commented out.
Why: with the branch, Aeneas fails on `check_accelerated::TOKEN.get()` ("Internal error"; the
SIMD code `gf::accelerated`/`gf::check_accelerated` is excluded from the translation).
Behaviour: identical (the portable multiplications compute the same products).

diff --git a/src/encoding/gf.rs b/src/encoding/gf.rs
index 963e119..35769ec 100644
--- a/src/encoding/gf.rs
+++ b/src/encoding/gf.rs
@@ -214,14 +214,14 @@ pub fn parallel_mult(a: GF16, into: &mut [GF16]) {
 }
 
 fn mul2_u16(a: u16, b1: u16, b2: u16) -> (u16, u16) {
-    #[cfg(all(
-        not(hax),
-        any(target_arch = "x86", target_arch = "x86_64", target_arch = "aarch64")
-    ))]
-    if check_accelerated::TOKEN.get() {
-        return accelerated::mul2(a, b1, b2);
-    }
+    // #[cfg(all(
+    //     not(hax),
+    //     any(target_arch = "x86", target_arch = "x86_64", target_arch = "aarch64")
+    // ))]
+    // if check_accelerated::TOKEN.get() {
+    //     return accelerated::mul2(a, b1, b2);
+    // }
     (unaccelerated::mul(a, b1), unaccelerated::mul(a, b2))
 }
 
 #[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
