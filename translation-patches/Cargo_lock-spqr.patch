Translation patch: Cargo.lock (version of the `spqr` package itself)

Change: the lock file entry of `spqr` is updated from 1.5.3 to 1.6.0.
Why: upstream's v1.6.0 commit bumped the version in Cargo.toml but not in Cargo.lock, so the
translation's `cargo … --locked` refuses to run. All dependency versions stay as locked.
Behaviour: identical.

diff --git a/Cargo.lock b/Cargo.lock
index 8275d19..d0d09ba 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1200,7 +1200,7 @@ checksum = "d372029cb5195f9ab4e4b9aef550787dce78b124fcaee8d82519925defcd6f0d"
 
 [[package]]
 name = "spqr"
-version = "1.5.3"
+version = "1.6.0"
 dependencies = [
  "cpufeatures",
  "curve25519-dalek",
