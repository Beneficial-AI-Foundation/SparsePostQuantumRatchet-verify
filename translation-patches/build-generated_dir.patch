Translation patch: build.rs main and the include of the prost output (src/proto/pq_ratchet.rs)

Change: with `extraction`, prost writes its output into `<crate>/generated/` instead of
`$OUT_DIR`, and `src/proto/pq_ratchet.rs` includes it from there.
Why: the translation records the source path of every generated item (doc comments,
translation.json); `$OUT_DIR` is an absolute, per-build path, which would make the committed
translation non-reproducible.
Behaviour: identical (only with `extraction`; it can panic if `generated/` cannot be created).
Relies on: Cargo-features.patch (defines the `extraction` feature).

diff --git a/build.rs b/build.rs
index b7797fe..fb61f82 100644
--- a/build.rs
+++ b/build.rs
@@ -4,10 +4,15 @@
 fn main() {
     let protos = ["src/proto/pq_ratchet.proto"];
     let mut prost_build = prost_build::Config::new();
+    if std::env::var_os("CARGO_FEATURE_EXTRACTION").is_some() {
+        let dir = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("generated");
+        std::fs::create_dir_all(&dir).expect("can create generated/");
+        prost_build.out_dir(dir);
+    }
     prost_build
         .compile_protos(&protos, &["src"])
         .expect("Protobufs in src are valid");
     for proto in &protos {
         println!("cargo:rerun-if-changed={proto}");
     }
 }
diff --git a/src/proto/pq_ratchet.rs b/src/proto/pq_ratchet.rs
index fe5b914..e02991d 100644
--- a/src/proto/pq_ratchet.rs
+++ b/src/proto/pq_ratchet.rs
@@ -1,6 +1,12 @@
