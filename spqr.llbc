          Ok(Send {\n                    state: Self::KeysSampled(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::Hdr(chunk),\n                    },\n                    key: None,\n                })\n            }\n            Self::HeaderSent(state) => {\n                let epoch = state.epoch();\n                let (state, chunk) = state.send_ek_chunk();\n                Ok(Send {\n                    state: Self::HeaderSent(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::Ek(chunk),\n                    },\n                    key: None,\n                })\n            }\n            Self::Ct1Received(state) => {\n                let epoch = state.epoch();\n                let (state, chunk) = state.send_ek_chunk();\n\n                Ok(Send {\n                    state: Self::Ct1Received(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::EkCt1Ack(chunk),\n                    },\n                    key: None,\n                })\n            }\n            Self::EkSentCt1Received(state) => {\n                let epoch = state.epoch();\n\n                Ok(Send {\n                    state: Self::EkSentCt1Received(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::Ct1Ack(true),\n                    },\n                    key: None,\n                })\n            }\n\n            ////////////////////////////////////////////////////////////////////////////////\n            // send_ct\n            ////////////////////////////////////////////////////////////////////////////////\n            Self::NoHeaderReceived(state) => {\n                let epoch = state.epoch();\n\n                Ok(Send {\n                    state: Self::NoHeaderReceived(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::None,\n                    },\n                    key: None,\n                })\n            }\n            Self::HeaderReceived(state) => {\n                let epoch = state.epoch();\n                let (state, chunk, epoch_secret) = state.send_ct1_chunk(rng);\n\n                // #[cfg(not(hax))]\n                // log::info!(\n                //     \"spqr v1.send_ct.send epoch {}: HeaderReceived -> Ct1Sampled\",\n                //     epoch\n                // );\n                Ok(Send {\n                    state: Self::Ct1Sampled(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::Ct1(chunk),\n                    },\n                    key: Some(epoch_secret),\n                })\n            }\n            Self::Ct1Sampled(state) => {\n                let epoch = state.epoch();\n                let (state, chunk) = state.send_ct1_chunk();\n\n                Ok(Send {\n                    state: Self::Ct1Sampled(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::Ct1(chunk),\n                    },\n                    key: None,\n                })\n            }\n            Self::EkReceivedCt1Sampled(state) => {\n                let epoch = state.epoch();\n                let (state, chunk) = state.send_ct1_chunk();\n\n                Ok(Send {\n                    state: Self::EkReceivedCt1Sampled(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::Ct1(chunk),\n                    },\n                    key: None,\n                })\n            }\n            Self::Ct1Acknowledged(state) => {\n                let epoch = state.epoch();\n\n                Ok(Send {\n                    state: Self::Ct1Acknowledged(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::None,\n                    },\n                    key: None,\n                })\n            }\n            Self::Ct2Sampled(state) => {\n                let epoch = state.epoch();\n                let (state, chunk) = state.send_ct2_chunk();\n\n                Ok(Send {\n                    state: Self::Ct2Sampled(state),\n                    msg: Message {\n                        epoch,\n                        payload: MessagePayload::Ct2(chunk),\n                    },\n                    key: None,\n                })\n            }\n        }\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"R"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":22,"beg":{"line":115,"col":26},"end":{"line":115,"col":29}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":22,"beg":{"line":115,"col":32},"end":{"line":115,"col":41}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":1863},{"Deduplicated":40691}],"output":{"Deduplicated":2566}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":22,"beg":{"line":115,"col":4},"end":{"line":273,"col":5}},"generated_from_span":null},"bound_body_regions":189,"locals":{"arg_count":2,"l