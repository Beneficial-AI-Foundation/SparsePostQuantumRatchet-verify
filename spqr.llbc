,{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":12443},"kind":"InherentImplBlock"}}},{"Ident":["lagrange_interpolate_complete",0]}],"span":{"data":{"file_id":51,"beg":{"line":197,"col":4},"end":{"line":223,"col":5}},"generated_from_span":null},"source_text":"fn lagrange_interpolate_complete(&mut self, pts: &[Pt], i: usize) {\n        let pi = &pts[i];\n\n        // Compute the scaling factor.\n        let mut denominator = GF16::ONE;\n        for pj in pts {\n            if pi.x == pj.x {\n                continue;\n            }\n            denominator *= pi.x - pj.x;\n        }\n        let scale = pi.y / denominator;\n\n        // Divide out (x - pi.x) using plain old long division, and scale as we go.\n        // This avoids having to reload the same value from memory twice.\n        // Remember our coefficients are in little-endian order, so we start from the end.\n        let _init_l = self.coefficients.len();\n        for j in 1..self.coefficients.len() {\n            hax_lib::loop_invariant!(|_: usize| self.coefficients.len() == _init_l);\n            let i = self.coefficients.len() - j;\n            let negative_delta = self.coefficients[i] * pi.x;\n            self.coefficients[i] *= scale;\n            self.coefficients[i - 1] += negative_delta;\n        }\n        #[cfg(not(hax))]\n        debug_assert_eq!(self.coefficients[0], GF16::ZERO, \"should divide cleanly\");\n    }","attr_info":{"attributes":[{"DocComment":" Given `PRODUCT(x - pi.x)`, creates something very close to the Lagrange poly for `pts[i]` in"},{"DocComment":" `pts`."},{"DocComment":""},{"DocComment":" This computes `f(pts[i].x) == pts[i].y`, and `f(pts[*].x) == 0` for all other points. It"},{"DocComment":" does so by first dividing out the specific `(x - pi.x)` we care about, then scaling so that"},{"DocComment":" the remaining polynomial produces `pi.y` at `pi.x`."},{"DocComment":""},{"DocComment":" However, due to our representation, the result we actually end up with is scaled by `x`."},{"DocComment":" It's cheaper to have callers deal with that manually than to adjust it here, though."},{"DocComment":""},{"DocComment":" This does O(N) work: one loop over the coefficients to divide out the term we need, one loop"},{"DocComment":" over the points to calculate the scaling factor, and then one final loop to scale the"},{"DocComment":" coefficients."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":41021},{"HashConsedValue":[41022,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":12855},"Shared"]}]},{"Deduplicated":2971}],"output":{"Deduplicated":1645}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":51,"beg":{"line":197,"col":4},"end":{"line":223,"col":5}},"generated_from_span":null},"bound_body_regions":106,"locals":{"arg_count":3,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":51,"beg":{"line":197,"col":69},"end":{"line":197,"col":69}},"generated_from_span":null},"ty":{"Deduplicated":1645}},{"index":1,"name":"self","span":{"data":{"file_id":51,"beg":{"line":197,"col":37},"end":{"line":197,"col":46}},"generated_from_span":null},"ty":{"Deduplicated":20038}},{"index":2,"name":"pts","span":{"data":{"file_id":51,"beg":{"line":197,"col":48},"end":{"line":197,"col":51}},"generated_from_span":null},"ty":{"Deduplicated":19923}},{"index":3,"name":"i","span":{"data":{"file_id":51,"beg":{"line":197,"col":60},"end":{"line":197,"col":61}},"generated_from_span":null},"ty":{"Deduplicated":2971}},{"index":4,"name":"pi","