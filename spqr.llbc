nt":" // elements to produce is the length of array down there: only arrays of"},{"DocComment":" // equal lengths can be compared, so the const generic parameter `N` is"},{"DocComment":" // inferred to be 5, thus creating array of 5 elements."},{"DocComment":""},{"DocComment":" let array = core::array::from_fn(|i| i);"},{"DocComment":" // indexes are:    0  1  2  3  4"},{"DocComment":" assert_eq!(array, [0, 1, 2, 3, 4]);"},{"DocComment":""},{"DocComment":" let array2: [usize; 8] = core::array::from_fn(|i| i * 2);"},{"DocComment":" // indexes are:     0  1  2  3  4  5   6   7"},{"DocComment":" assert_eq!(array2, [0, 2, 4, 6, 8, 10, 12, 14]);"},{"DocComment":""},{"DocComment":" let bool_arr = core::array::from_fn::<_, 5, _>(|i| i % 2 == 0);"},{"DocComment":" // indexes are:       0     1      2     3      4"},{"DocComment":" assert_eq!(bool_arr, [true, false, true, false, true]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can also capture things, for example to create an array full of clones"},{"DocComment":" where you can't just use `[item; N]` because it's not `Copy`:"},{"DocComment":" ```"},{"DocComment":" let my_string: [String; 2] = std::array::from_fn(|i| format!(\"Hello {i}\"));"},{"DocComment":" assert_eq!(my_string, [\"Hello 0\", \"Hello 1\"]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The array is generated in ascending index order, starting from the front"},{"DocComment":" and going towards the back, so you can use closures with mutable state:"},{"DocComment":" ```"},{"DocComment":" let mut state = 1;"},{"DocComment":" let a = std::array::from_fn(|_| { let x = state; state *= 2; x });"},{"DocComment":" assert_eq!(a, [1, 2, 4, 8, 16, 32]);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"F"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":2971}}],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":59,"beg":{"line":110,"col":24},"end":{"line":110,"col":40}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":59,"beg":{"line":112,"col":7},"end":{"line":112,"col":32}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":35,"generics":{"regions":[],"types":[{"Deduplicated":40278},{"Deduplicated":21115},{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"data":{"file_id":59,"beg":{"line":112,"col":35},"end":{"line":112,"col":51}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":40278}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":40278}],"output":{"Deduplicated":40328}},"src":"TopLevel","is_global_initializer":null,"body":"Opaque"},{"def_id":1042,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":2040},"kind":"InherentImplBlock"}}},{"Ident":["chunks_exact",0]}],"span":{"data":{"file_id":43,"beg":{"line":1243,"col":4},"end":{"line":1243,"col":77}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns an iterator over `chunk_size` elements of the slice at a time, starting at the"},{"DocComment":" beginning of the slice."},{"DocComment":""},{"DocComment":" The chunks are slices and do not overlap. If `chunk_size` does not divide the length of the"},{"DocComment":" slice, then the last up to `chunk_size-1` elements will be omitted and can be retrieved"},{"DocComment":" from the `remainder` function of the iterator."},{"DocComment":""},{"DocComment":" Due to each chunk having exactly `chunk_size` elements, the compiler can often optimize the"},{"DocComment":" resulting code better than in the case of [`chunks`]."},{"DocComment":""},{"DocComment":" See [`chunks`] for a variant of this iterator that also returns the remainder as a smaller"},{"DocComment":" chunk, and [`rchunks_exact`] for the same iterator but starting at the end of the slice."},{"DocComment":""},{"DocComment":" If your `chunk_size` is a constant, consider using [`as_chunks`] instead, which will"},{"DocComment":" give references to arrays of exactly that length, rather than slices."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `chunk_size` is zero."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let mut iter = slice.chunks_exact(2);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['l', 'o']);"},{"DocComment":" assert_eq!(iter.next().unwrap(), &['r', 'e']);"},{"DocComment":" assert!(iter.next().is_none());"},{"DocComment":" assert_eq!(iter.remainder(), &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`chunks`]: slice::chunks"},{"DocComment":" [`rchunks_exact`]: slice::rchunks_exact"},{"DocComment":" [`as_chunks`]: slice::as_chunks"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":40330},{"Deduplicated":2971}],"output":{"HashConsedValue":[40474,{"Adt":{"id":{"Ad