_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,8],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,{"def_id":121,"item_meta":{"name":[{"Ident":["rand",0]},{"Ident":["distr",0]},{"Ident":["StandardUniform",0]}],"span":{"data":{"file_id":84,"beg":{"line":214,"col":0},"end":{"line":214,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The Standard Uniform distribution"},{"DocComment":""},{"DocComment":" This [`Distribution`] is the *standard* parameterization of [`Uniform`]. Bounds"},{"DocComment":" are selected according to the output type."},{"DocComment":""},{"DocComment":" Assuming the provided `Rng` is well-behaved, these implementations"},{"DocComment":" generate values with the following ranges and distributions:"},{"DocComment":""},{"DocComment":" * Integers (`i8`, `i32`, `u64`, etc.) are uniformly distributed"},{"DocComment":"   over the whole range of the type (thus each possible value may be sampled"},{"DocComment":"   with equal probability)."},{"DocComment":" * `char` is uniformly distributed over all Unicode scalar values, i.e. all"},{"DocComment":"   code points in the range `0...0x10_FFFF`, except for the range"},{"DocComment":"   `0xD800...0xDFFF` (the surrogate code points). This includes"},{"DocComment":"   unassigned/reserved code points."},{"DocComment":"   For some uses, the [`Alphanumeric`] or [`Alphabetic`] distribution will be more"},{"DocComment":"   appropriate."},{"DocComment":" * `bool` samples `false` or `true`, each with probability 0.5."},{"DocComment":" * Floating point types (`f32` and `f64`) are uniformly distributed in the"},{"DocComment":"   half-open range `[0, 1)`. See also the [notes below](#floating-point-implementation)."},{"DocComment":" * Wrapping integers ([`Wrapping<T>`]), besides the type identical to their"},{"DocComment":"   normal integer variants."},{"DocComment":" * Non-zero integers ([`NonZeroU8`]), which are like their normal integer"},{"DocComment":"   variants but cannot sample zero."},{"DocComment":""},{"DocComment":" The `StandardUniform` distribution also supports generation of the following"},{"DocComment":" compound types where all component types are supported:"},{"DocComment":""},{"DocComment":" * Tuples (up to 12 elements): each element is sampled sequentially and"},{"DocComment":"   independently (thus, assuming a well-behaved RNG, there is no correlation"},{"DocComment":"   between elements)."},{"DocComment":" * Arrays `[T; n]` where `T` is supported. Each element is sampled"},{"DocComment":"   sequentially and independently. Note that for small `T` this usually"},{"DocComment":"   results in the RNG discarding random bits; see also [`Rng::fill`] which"},{"DocComment":"   offers a more efficient approach to filling an array of integer types"},{"DocComment":"   with random data."},{"DocComment":" * SIMD types (requires [`simd_support`] feature) like x86's [`__m128i`]"},{"DocComment":"   and `std::simd`'s [`u32x4`], [`f32x4`] and [`mask32x4`] types are"},{"DocComment":"   effectively arrays of integer or floating-point types. Each lane is"},{"DocComment":"   sampled independently, potentially with more efficient random-bit-usage"},{"DocComment":"   (and a different resulting value) than would be achieved with sequential"},{"DocComment":"   sampling (as with the array types above)."},{"DocComment":""},{"DocComment":" ## Custom implementations"},{"DocComment":""},{"DocComment":" The [`StandardUniform`] distribution may be implemented for user types as follows:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" use rand::Rng;"},{"DocComment":" use rand::distr::{Distribution, StandardUniform};"},{"DocComment":""},{"DocComment":" struct MyF32 {"},{"DocComment":"     x: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Distribution<MyF32> for StandardUniform {"},{"DocComment":"     fn sample<R: Rng + ?Sized>(&self, rng: &mut R) -> MyF32 {"},{"DocComment":"         MyF32 { x: rng.random() }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Example usage"},{"DocComment":" ```"},{"DocComment":" use rand::prelude::*;"},{"DocComment":" use rand::distr::StandardUniform;"},{"DocComment":""},{"DocComment":" let val: f32 = rand::rng().sample(StandardUniform);"},{"DocComment":" println!(\"f32 from [0, 1): {}\", val);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Floating point implementation"},{"DocComment":" The floating point implementations for `StandardUniform` generate a random value in"},{"DocComment":" the half-open interval `[0, 1)`, i.e. including 0 but not 1."},{"DocComment":""},{"DocComment":" All values that can be generated are of the form `n * ε/2`. For `f32`"},{"DocComment":" the 24 most significant random bits of a `u32` are used and for `f64` the"},{"DocComment":" 53 most significant bits of a `u64` are used. The conversion uses the"},{"DocComment":" multiplicative method: `(rng.gen::<$uty>() >> N) as $ty * (ε/2)`."},{"DocComment":""},{"DocComment":" See also: [`Open01`] which samples from `(0, 1)`, [`OpenClosed01`] which"},{"DocComment":" samples from `(0, 1]` and `Rng::random_range(0..1)` which also samples from"},{"DocComment":" `[0, 1)`. Note that `Open01` uses transmute-based methods which yield 1 bit"},{"DocComment":" less precision but may perform faster on some architectures (on modern Intel"},{"DocComment":" CPUs all methods have approximately equal performance)."},{"DocComment":""},{"DocComment":" [`Uniform`]: uniform::Uniform"},{"DocComment":" [`Wrapping<T>`]: std::num::Wrapping"},{"DocComment":" [`NonZeroU8`]: std::num::NonZeroU8"},{"DocComment":" [`__m128i`]: https://doc.rust-lang.org/core/arch/x86/struct.__m128i.html"},{"DocComment":" [`u32x4`]: std::simd::u32x4"},{"DocComment":" [`f32x4`]: std::simd::f32x4"},{"DocComment":" [`mask32x4`]: std::simd::mask32x4"},{"DocComment":" [`simd_support`]: https://github.com/rust-random/rand#crate-features"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":122,"item_meta":{"name":[{"Ident":["rand",0]},{"Ident":["distr",0]},{"Ident":["distribution",0]},{"Ident":["Iter",0]}],"span":{"data":{"file_id":83,"beg":{"line":125,"col":0},"end":{"line":125,"col":24}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator over a [`Distribution`]"},{"DocComment":""},{"DocComment":" This iterator yields random values of type `T` with distribution `D`"},{"DocComment":" from a random generator of type `R`."},{"DocComment":""},{"DocComment":" Construct this `struct` using [`Distribution::sample_iter`] or"},{"DocComment":" [`Rng::sample_iter`]. It is also used by [`Rng::random_iter`] and"},{"DocComment":" [`crate::random_iter`]."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"D"},{"index":1,"name":"R"},{"index":2,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},null,