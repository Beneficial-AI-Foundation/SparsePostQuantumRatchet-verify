Comment":" `self.nth(step-1)`, …, but is also free to behave like the sequence"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`,"},{"DocComment":" `advance_n_and_return_first(&mut self, step)`, …"},{"DocComment":" Which way is used may change for some iterators for performance reasons."},{"DocComment":" The second way will advance the iterator earlier and may consume more items."},{"DocComment":""},{"DocComment":" `advance_n_and_return_first` is the equivalent of:"},{"DocComment":" ```"},{"DocComment":" fn advance_n_and_return_first<I>(iter: &mut I, n: usize) -> Option<I::Item>"},{"DocComment":" where"},{"DocComment":"     I: Iterator,"},{"DocComment":" {"},{"DocComment":"     let next = iter.next();"},{"DocComment":"     if n > 1 {"},{"DocComment":"         iter.nth(n - 2);"},{"DocComment":"     }"},{"DocComment":"     next"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" The method will panic if the given step is `0`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [0, 1, 2, 3, 4, 5];"},{"DocComment":" let mut iter = a.into_iter().step_by(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(0));"},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":115,"beg":{"line":64,"col":7},"end":{"line":64,"col":15}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":21,"generics":{"regions":[],"types":[{"Deduplicated":40277},{"Deduplicated":40278}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":40465},{"Deduplicated":2971}],"output":{"HashConsedValue":[41682,{"Adt":{"id":{"Adt":80},"generics":{"regions":[],"types":[{"Deduplicated":40465}],"const_generics":[],"trait_refs":[]}}}]}},"src":{"TraitImpl":{"impl_ref":{"id":454,"generics":{"regions":[],"types":[{"Deduplicated":40277},{"Deduplicated":40278}],"const_generics":[],"trait_refs":[{"Deduplicated":40338}]}},"trait_ref":{"id":21,"generics":{"regions":[],"types":[{"Deduplicated":40465},{"Deduplicated":40466}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":7},"reuses_default":true}},"is_global_initializer":null,"body":"Opaque"},{"def_id":1684,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["enumerate",0]},{"Impl":{"Trait":454}},{"Ident":["map",0]}],"span":{"data":{"file_id":115,"beg":{"line":62,"col":0},"end":{"line":64,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Takes a closure and creates an iterator which calls that closure on each"},{"DocComment":" element."},{"DocComment":""},{"DocComment":" `map()` transforms one iterator into another, by means of its argument:"},{"DocComment":" something that implements [`FnMut`]. It produces a new iterator which"},{"DocComment":" calls this closure on each element of the original iterator."},{"DocComment":""},{"DocComment":" If you are good at thinking in types, you can think of `map()` like this:"},{"DocComment":" If you have an iterator that gives you elements of some type `A`, and"},{"DocComment":" you want an iterator of some other type `B`, you can use `map()`,"},{"DocComment":" passing a closure that takes an `A` and returns a `B`."},{"DocComment":""},{"DocComment":" `map()` is conceptually similar to a [`for`] loop. However, as `map()` is"},{"DocComment":" lazy, it is best used when you're already working with other iterators."},{"DocComment":" If you're doing some sort of looping for a side effect, it's considered"},{"DocComment":" more idiomatic to use [`for`] than `map()`."},{"DocComment":""},{"DocComment":" [`for`]: ../../book/ch03-05-control-flow.html#looping-through-a-collection-with-for"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.iter().map(|x| 2 * x);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(2));"},{"DocComment":" assert_eq!(iter.next(), Some(4));"},{"DocComment":" assert_eq!(iter.next(), Some(6));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you're doing some sort of side effect, prefer [`for`] to `map()`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" // don't do this:"},{"DocComment":" (0..5).map(|x| println!(\"{x}\"));"},{"DocComment":""},{"DocComment":" // it won't even execute, as it is lazy. Rust will warn you about this."},{"DocComment":""},{"DocComment":" // Instead, use a for-loop:"},{"DocComment":" for x in 0..5 {"},{"DocComment":"     println!(\"{x}\");"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"IteratorMap"},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"B"},{"index":2,"name":"F"},{"index":3,"name":"Clause0_Item"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":115,"beg":{"line":64,"col":7},"end":{"line":64,"col":15}},"generated_from_span":null},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":21,"generics":{"regions":[],"types":[{"Deduplicated":40277},{"Deduplicated":40317}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"sp