107,"col":21}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"data":{"file_id":29,"beg":{"line":105,"col":28},"end":{"line":105,"col":31}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":1414}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"decode","attr_info":{"attributes":[{"DocComment":" Decodes an instance of the message from a buffer."},{"DocComment":""},{"DocComment":" The entire buffer will be consumed."}],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":1209}],"output":{"Deduplicated":40584}},"item":{"id":78,"generics":{"regions":[],"types":[{"Deduplicated":40277},{"Deduplicated":1209}],"const_generics":[],"trait_refs":[{"Deduplicated":40583},{"HashConsedValue":[40585,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":16,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}}]},{"HashConsedValue":[8214,{"kind":{"Clause":{"Bound":[0,1]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":1414}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[11,7]}},null,null,null,{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"clear","attr_info":{"attributes":[{"DocComment":" Clears the message, resetting all fields to their default."}],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":40573}],"output":{"Deduplicated":1645}},"item":{"id":206,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[{"Deduplicated":40583}]}}},"kind":{"TraitMethod":[11,11]}}],"vtable":{"id":{"Adt":116},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnOnce",0]}],"span":{"data":{"file_id":34,"beg":{"line":242,"col":0},"end":{"line":242,"col":35}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The version of the call operator that takes a by-value receiver."},{"DocComment":""},{"DocComment":" Instances of `FnOnce` can be called, but might not be callable multiple"},{"DocComment":" times. Because of this, if the only thing known about a type is that it"},{"DocComment":" implements `FnOnce`, it can only be called once."},{"DocComment":""},{"DocComment":" `FnOnce` is implemented automatically by closures that might consume captured"},{"DocComment":" variables, as well as all types that implement [`FnMut`], e.g., (safe)"},{"DocComment":" [function pointers] (since `FnOnce` is a supertrait of [`FnMut`])."},{"DocComment":""},{"DocComment":" Since both [`Fn`] and [`FnMut`] are subtraits of `FnOnce`, any instance of"},{"DocComment":" [`Fn`] or [`FnMut`] can be used where a `FnOnce` is expected."},{"DocComment":""},{"DocComment":" Use `FnOnce` as a bound when you want to accept a parameter of function-like"},{"DocComment":" type and only need to call it once. If you need to call the parameter"},{"DocComment":" repeatedly, use [`FnMut`] as a bound; if you also need it to not mutate"},{"DocComment":" state, use [`Fn`]."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Using a `FnOnce` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn consume_with_relish<F>(func: F)"},{"DocComment":"     where F: FnOnce() -> String"},{"DocComment":" {"},{"DocComment":"     // `func` consumes its captured variables, so it cannot be run more"},{"DocComment":"     // than once."},{"DocComment":"     println!(\"Consumed: {}\", func());"},{"DocComment":""},{"DocComment":"     println!(\"Delicious!\");"},{"DocComment":""},{"DocComment":"     // Attempting to invoke `func()` again will throw a `use of moved"},{"DocComment":"     // value` error for `func`."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let x = String::from(\"x\");"},{"DocComment":" let consume_and_return_x = move || x;"},{"DocComment":" consume_with_relish(consume_and_return_x);"},{"DocComment":""},{"DocComment":" // `consume_and_return_x` can no longer be invoked at this point"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"fn_once"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"Args"},{"index":2,"name":"Self_Output"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"call_once","attr_info":{"attributes":[{"DocComment":" Performs the call operation."}],"inline":null,"rename":null,"public":true},"signature":{"is_unsafe":false,"abi":{"Other":"rust-call"},"inputs":[{"Deduplicated":40277},{"Deduplicated":40278}],"output":{"Deduplicated":40311}},"item":{"id":220,"generics":{"regions":[],"types":[{"Deduplicated":40277},{"Deduplicated":40278},{"Deduplicated":40311}],"const_generics":[],"trait_refs":[{"HashConsedValue":[40586,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":40277},{"Deduplicated":40278},{"Deduplicated":40311}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[12,0]}}],"vtable":{"id":{"Adt":120},"generics":{"regions":[],"types":[{"Deduplicated":40278},{"Deduplicated":40311}],"const_generics":[],"trait_refs":[]}}},{"def_id":13,"item_meta":{"name":[{"Ident":["rand",0]},{"Ident":["rng",0]},{"Ident":["Rng",0]}],"span":{"data":{"file_id":35,"beg":{"line":58,"col":0},"end":{"line":58,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" User-level interface for RNGs"},{"DocComment":""},{"DocComment":" [`RngCore`] is the `dyn`-safe implementation-level interface for Random"},{"DocComment":" (Number) Generators. This trait, `Rng`, provides a user-level interface on"},{"DocComment":" RNGs. It is implemented automatically for any `R: RngCore`."},{"DocComment":""},{"DocComment":" This trait must usually be brought into scope via `use rand::Rng;` or"},{"DocComment":" `use rand::prelude::*;`."},{"DocComment":""},{"DocComment":" # Generic usage"},{"DocComment":""},{"DocComment":" The basic pattern is `fn foo<R: Rng + ?Sized>(rng: &mut R)`. Some"},{"DocComment":" things are worth noting here:"},{"DocComment":""},{"DocComment":" - Since `Rng: RngCore` and every `RngCore` implements `Rng`, it makes no"},{"DocComment":"   difference whether we use `R: Rng` or `R: RngCore`."},{"DocComment":" - The `+ ?Sized` un-bounding allows functions to be called directly on"},{"DocComment":"   type-erased references; i.e. `foo(r)` where `r: &mut dyn RngCore`. Without"},{"DocComment":"   this it would be necessary to write `foo(&mut r)`."},{"DocComment":""},{"DocComment":" An alternative pattern is possible: `fn foo<R: Rng>(rng: R)`. This has some"},{"DocComment":" trade-offs. It allows the argument to be consumed directly without a `&mut`"},{"DocComment":" (which is how `from_rng(rand::rng())` works); also it still works directly"},{"DocComment":" on references (including type-erased references). Unfortunately within the"},{"DocComment":" function `foo` it is not known whether `rng` is a reference type or not,"},{"DocComment":" hence many uses of `rng` require an extra reference, either explicitly"},{"DocComment":" (`distr.sample(&mut rng)`) or implicitly (`rng.random()`); one may hope the"},{"DocComment":" optimiser can remove redundant references later."},{"DocComment":""},{"DocComment":" Example:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use rand::Rng;"},{"DocComment":""},{"DocComment":" fn foo<R: Rng + ?Sized>(rng: &mut R) -> f32 {"},{"DocComment":"     rng.random()"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" # let v = foo(&mut rand::rng());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":35,"beg":{"line":58,"col":15},"end":{"line":58,"col":22}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":20,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[null,null,null,null,null,null,null,null,null,null,null,null],"vtable":null},{"def_id":14,"item_meta":{"name":[{"Ident":["rand_core",0]},{"Ident":["CryptoRng",0]}],"span":{"data":{"file_id":37,"beg":{"line":204,"col":0},"end":{"line":204,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker trait over [`RngCore`] for securely unpredictable RNGs"},{"DocComment":""},{"DocComment":" This marker trait indicates that the implementing generator is intended,"},{"DocComment":" when correctly seeded and protected from side-channel attacks such as a"},{"DocComment":" leaking of state, to be a cryptographically secure generator. This trait is"},{"DocComment":" provided as a tool to aid review of cryptographic code, but does not by"},{"DocComment":" itself guarantee suitability for cryptographic applications."},{"DocComment":""},{"DocComment":" Implementors of `CryptoRng` automatically implement the [`TryCryptoRng`]"},{"DocComment":" trait."},{"DocComment":""},{"DocComment":" Implementors of `CryptoRng` should only implement [`Default`] if the"},{"DocComment":" `default()` instances are themselves secure generators: for example if the"},{"DocComment":" implementing type is a stateless interface over a secure external generator"},{"DocComment":" (like [`OsRng`]) or if the `default()` instance uses a strong, fresh seed."},{"DocComment":""},{"DocComment":" Formally, a CSPRNG (Cryptographically Secure Pseudo-Random Number Generator)"},{"DocComment":" should satisfy an additional property over other generators: assuming that"},{"DocComment":" the generator has been appropriately seeded and has unknown state, then"},{"DocComment":" given the first *k* bits of an algorithm's output"},{"DocComment":" sequence, it should not be possible using polynomial-time algorithms to"},{"DocComment":" predict the next bit with probability significantly greater than 50%."},{"DocComment":""},{"DocComment":" An optional property of CSPRNGs is backtracking resistance: if the CSPRNG's"},{"DocComment":" state is revealed, it will not be computationally-feasible to reconstruct"},{"DocComment":" prior output values. This property is not required by `CryptoRng`."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":37,"beg":{"line":204,"col":21},"end":{"line":204,"col":28}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":20,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":123},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":15,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]}],"span":{"data":{"file_id":42,"beg":{"line":163,"col":0},"end":{"line":163,"col":73}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A helper trait used for indexing operations."},{"DocComment":""},{"DocComment":" Implementations of this trait have to promise that if the argument"},{"DocComment":" to `get_unchecked(_mut)` is a safe reference, then so is the result."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"SliceIndex"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"},{"index":1,"name":"T"},{"index":2,"name":"Self_Output"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"data":{"file_id":42,"beg":{"line":163,"col":46},"end":{"line":163,"col":73}},"generated_from_span":null},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":38,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"