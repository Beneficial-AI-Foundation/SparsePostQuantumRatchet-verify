l},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":47,"beg":{"line":142,"col":4},"end":{"line":142,"col":24}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The number of bytes necessary to get the value"}],"inline":null,"rename":null,"public":true},"name":"requested","ty":{"Deduplicated":2971}},{"span":{"data":{"file_id":47,"beg":{"line":145,"col":4},"end":{"line":145,"col":24}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The number of bytes available in the buffer"}],"inline":null,"rename":null,"public":true},"name":"available","ty":{"Deduplicated":2971}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0,8],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":143,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["bytes",0]},{"Ident":["Bytes",0]}],"span":{"data":{"file_id":93,"beg":{"line":102,"col":0},"end":{"line":102,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A cheaply cloneable and sliceable chunk of contiguous memory."},{"DocComment":""},{"DocComment":" `Bytes` is an efficient container for storing and operating on contiguous"},{"DocComment":" slices of memory. It is intended for use primarily in networking code, but"},{"DocComment":" could have applications elsewhere as well."},{"DocComment":""},{"DocComment":" `Bytes` values facilitate zero-copy network programming by allowing multiple"},{"DocComment":" `Bytes` objects to point to the same underlying memory."},{"DocComment":""},{"DocComment":" `Bytes` does not have a single implementation. It is an interface, whose"},{"DocComment":" exact behavior is implemented through dynamic dispatch in several underlying"},{"DocComment":" implementations of `Bytes`."},{"DocComment":""},{"DocComment":" All `Bytes` implementations must fulfill the following requirements:"},{"DocComment":" - They are cheaply cloneable and thereby shareable between an unlimited amount"},{"DocComment":"   of components, for example by modifying a reference count."},{"DocComment":" - Instances can be sliced to refer to a subset of the original buffer."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::Bytes;"},{"DocComment":""},{"DocComment":" let mut mem = Bytes::from(\"Hello world\");"},{"DocComment":" let a = mem.slice(0..5);"},{"DocComment":""},{"DocComment":" assert_eq!(a, \"Hello\");"},{"DocComment":""},{"DocComment":" let b = mem.split_to(6);"},{"DocComment":""},{"DocComment":" assert_eq!(mem, \"world\");"},{"DocComment":" assert_eq!(b, \"Hello \");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Memory layout"},{"DocComment":""},{"DocComment":" The `Bytes` struct itself is fairly small, limited to 4 `usize` fields used"},{"DocComment":" to track information about which segment of the underlying memory the"},{"DocComment":" `Bytes` handle has access to."},{"DocComment":""},{"DocComment":" `Bytes` keeps both a pointer to the shared state containing the full memory"},{"DocComment":" slice and a pointer to the start of the region visible by the handle."},{"DocComment":" `Bytes` also tracks the length of its view into the memory."},{"DocComment":""},{"DocComment":" # Sharing"},{"DocComment":""},{"DocComment":" `Bytes` contains a vtable, which allows implementations of `Bytes` to define"},{"DocComment":" how sharing/cloning is implemented in detail."},{"DocComment":" When `Bytes::clone()` is called, `Bytes` will call the vtable function for"},{"DocComment":" cloning the backing storage in order to share it behind multiple `Bytes`"},{"DocComment":" instances."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which refer to constant memory (e.g. created"},{"DocComment":" via `Bytes::from_static()`) the cloning implementation will be a no-op."},{"DocComment":""},{"DocComment":" For `Bytes` implementations which point to a reference counted shared storage"},{"DocComment":" (e.g. an `Arc<[u8]>`), sharing will be implemented by increasing the"},{"DocComment":" reference count."},{"DocComment":""},{"DocComment":" Due to this mechanism, multiple `Bytes` instances may point to the same"},{"DocComment":" shared memory region."},{"DocComment":" Each `Bytes` instance can point to different sections within that"},{"DocComment":" memory region, and `Bytes` instances may or may not have overlapping views"},{"DocComment":" into the memory."},{"DocComment":""},{"DocComment":" The following diagram visualizes a scenario where 2 `Bytes` instances make"},{"DocComment":" use of an `Arc`-based backing storage, and provide access to different views:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":""},{"DocComment":"    Arc ptrs                   ┌─────────┐"},{"DocComment":"    ________________________ / │ Bytes 2 │"},{"DocComment":"   /                           └─────────┘"},{"DocComment":"  /          ┌───────────┐     |         |"},{"DocComment":" |_________/ │  Bytes 1  │     |         |"},{"DocComment":" |           └───────────┘     |         |"},{"DocComment":" |           |           | ___/ data     | tail"},{"DocComment":" |      data |      tail |/              |"},{"DocComment":" v           v           v               v"},{"DocComment":" ┌─────┬─────┬───────────┬───────────────┬─────┐"},{"DocComment":" │ Arc │     │           │               │     │"},{"DocComment":" └─────┴─────┴───────────┴───────────────┴─────┘"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":32,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[8,16,24,0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":144,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["take",0]},{"Ident":["Take",0]}],"span":{"data":{"file_id":94,"beg":{"line":13,"col":0},"end":{"line":13,"col":18}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A `Buf` adapter which limits the bytes read from an underlying buffer."},{"DocComment":""},{"DocComment":" This struct is generally created by calling `take()` on `Buf`. See"},{"DocComment":" documentation of [`take()`](Buf::take) for more details."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":145,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["chain",0]},{"Ident":["Chain",0]}],"span":{"data":{"file_id":95,"beg":{"line":30,"col":0},"end":{"line":30,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A `Chain` sequences two buffers."},{"DocComment":""},{"DocComment":" `Chain` is an adapter that links two underlying buffers and provides a"},{"DocComment":" continuous view across both buffers. It is able to sequence either immutable"},{"DocComment":" buffers ([`Buf`] values) or mutable buffers ([`BufMut`] values)."},{"DocComment":""},{"DocComment":" This struct is generally created by calling [`Buf::chain`]. Please see that"},{"DocComment":" function's documentation for more detail."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::{Bytes, Buf};"},{"DocComment":""},{"DocComment":" let mut buf = (&b\"hello \"[..])"},{"DocComment":"     .chain(&b\"world\"[..]);"},{"DocComment":""},{"DocComment":" let full: Bytes = buf.copy_to_bytes(11);"},{"DocComment":" assert_eq!(full[..], b\"hello world\"[..]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Buf::chain`]: Buf::chain"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T"},{"index":1,"name":"U"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":146,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeTo",0]}],"span":{"data":{"file_id":63,"beg":{"line":281,"col":0},"end":{"line":281,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded exclusively above (`..end`)."},{"DocComment":""},{"DocComment":" The `RangeTo` `..end` contains all values with `x < end`."},{"DocComment":" It cannot serve as an [`Iterator`] because it doesn't have a starting point."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `..end` syntax is a `RangeTo`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((..5), std::ops::RangeTo { end: 5 });"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It does not have an [`IntoIterator`] implementation, so you can't use it in"},{"DocComment":" a `for` loop directly. This won't compile:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" // error[E0277]: the trait bound `std::ops::RangeTo<{integer}>:"},{"DocComment":" // std::iter::Iterator` is not satisfied"},{"DocComment":" for i in ..5 {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" When used as a [slicing index], `RangeTo` produces a slice of all array"},{"DocComment":" elements before the index indicated by `end`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]); // This is a `RangeTo`"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RangeTo"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":63,"beg":{"line":284,"col":4},"end":{"line":284,"col":16}},"generated_from_span":null},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","ty":{"Deduplicated":40277}}]},"layout":[],"ptr_metadata":"None"},{"def_id":147,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["RangeFrom",0]}],"span":{"data":{"file_id":63,"beg":{"line":197,"col":0},"end":{"line":197,"col":25}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A range only bounded inclusively below (`start..`)."},{"DocComment":""},{"DocComment":" The `RangeFrom` `start..` contains all values with `x >= start`."},{"DocComment":""},{"DocComment":" *Note*: Overflow in the [`Iterator`] implementation (when the contained"},{"DocComment":" data type reaches its numerical limit) is allowed to panic, wrap, or"},{"DocComment":" saturate. This behavior is defined by the implementation of the [`Step`]"},{"DocComment":" trait. For primitive integers, this follows the normal rules, and respects"},{"DocComment":" the overflow checks profile (panic in debug, wrap in release). Note also"},{"DocComment":" that overflow happens earlier than you might assume: the overflow happens"},{"DocComment":" in the call to `next` that yields the maximum value, as the range must be"},{"DocComment":" set to a state to yield the next value."},{"DocComment":""},{"DocComment":" [`Step`]: crate::iter::Step"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..` syntax is a `RangeFrom`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((2..), std::ops::RangeFrom { start: 2 });"},{"DocComment":" assert_eq!(2 + 3 + 4, (2..).take(3).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]); // This is a `RangeFrom`"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"RangeFrom"},"generics":{"regions":[],"types":[{"index":0,"name":"Idx"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":63,"beg":{"line":200,"col":4},"end":{"line":200,"col":18}},"generated_from_span":null},"attr_info":{"attributes"