ys = Vec::with_capacity(pts.len());\n                for i in 0..pts.len() {\n                    polys.push(Self::lagrange_interpolate_pt(&ones, i));\n                }\n                polys\n            }\n        };\n        Ok(Self::lagrange_sum(pts, &polys))\n    }","attr_info":{"attributes":[{"DocComment":" Given a set of \"complete\" points with x values that fully fill the"},{"DocComment":" range [0..pts.len()), return a polynomial that computes those points."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":41017}],"output":{"HashConsedValue":[20349,{"Adt":{"id":{"Adt":44},"generics":{"regions":[],"types":[{"Deduplicated":12443},{"Deduplicated":1645}],"const_generics":[],"trait_refs":[]}}}]}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":51,"beg":{"line":292,"col":4},"end":{"line":327,"col":5}},"generated_from_span":null},"bound_body_regions":191,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":51,"beg":{"line":292,"col":43},"end":{"line":292,"col":59}},"generated_from_span":null},"ty":{"Deduplicated":20349}},{"index":1,"name":"pts","span":{"data":{"file_id":51,"beg":{"line":292,"col":28},"end":{"line":292,"col":31}},"generated_from_span":null},"ty":{"Deduplicated":12857}},{"index":2,"name":null,"span":{"data":{"file_id":51,"beg":{"line":293,"col":23},"end":{"line":293,"col":45}},"generated_from_span":null},"ty":{"HashConsedValue":[20356,{"Adt":{"id":{"Adt":166},"generics":{"regions":[],"types":[{"HashConsedValue":[20355,{"Adt":{"id":{"Adt":152},"generics":{"regions":[{"Body":4}],"types":[{"Deduplicated":12363}],"const_generics":[],"trait_refs":[]}}}]}],"const_generi