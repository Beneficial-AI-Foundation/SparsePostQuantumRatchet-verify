e_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"Dyn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":1414}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":1414},"Erased"]}],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":1209},"kind":"Dyn"}},"field_map":[],"supertrait_map":[null,null]}},"kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["private",0]},{"Ident":["Internal",0]}],"span":{"data":{"file_id":18,"beg":{"line":268,"col":4},"end":{"line":268,"col":23}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":0,"align":1,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":38,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["any",0]},{"Ident":["TypeId",0]}],"span":{"data":{"file_id":19,"beg":{"line":724,"col":0},"end":{"line":724,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A `TypeId` represents a globally unique identifier for a type."},{"DocComment":""},{"DocComment":" Each `TypeId` is an opaque object which does not allow inspection of what's"},{"DocComment":" inside but does allow basic operations such as cloning, comparison,"},{"DocComment":" printing, and showing."},{"DocComment":""},{"DocComment":" A `TypeId` is currently only available for types which ascribe to `'static`,"},{"DocComment":" but this limitation may be removed in the future."},{"DocComment":""},{"DocComment":" While `TypeId` implements `Hash`, `PartialOrd`, and `Ord`, it is worth"},{"DocComment":" noting that the hashes and ordering will vary between Rust releases. Beware"},{"DocComment":" of relying on them inside of your code!"},{"DocComment":""},{"DocComment":" # Layout"},{"DocComment":""},{"DocComment":" Like other [`Rust`-representation][repr-rust] types, `TypeId`'s size and layout are unstable."},{"DocComment":" In particular, this means that you cannot rely on the size and layout of `TypeId` remaining the"},{"DocComment":" same between Rust releases; they are subject to change without prior notice between Rust"},{"DocComment":" releases."},{"DocComment":""},{"DocComment":" [repr-rust]: https://doc.rust-lang.org/reference/type-layout.html#r-layout.repr.rust.unspecified"},{"DocComment":""},{"DocComment":" # Danger of Improper Variance"},{"DocComment":""},{"DocComment":" You might think that subtyping is impossible between two static types,"},{"DocComment":" but this is false; there exists a static type with a static subtype."},{"DocComment":" To wit, `fn(&str)`, which is short for `for<'any> fn(&'any str)`, and"},{"DocComment":" `fn(&'static str)`, are two distinct, static types, and yet,"},{"DocComment":" `fn(&str)` is a subtype of `fn(&'static str)`, since any value of type"},{"DocComment":" `fn(&str)` can be used where a value of type `fn(&'static str)` is needed."},{"DocComment":""},{"DocComment":" This means that abstractions around `TypeId`, despite its"},{"DocComment":" `'static` bound on arguments, still need to worry about unnecessary"},{"DocComment":" and improper variance: it is advisable to strive for invariance"},{"DocComment":" first. The usability impact will be negligible, while the reduction"},{"DocComment":" in the risk of unsoundness will be most welcome."},{"DocComment":""},{"DocComment":" ## Examples"},{"DocComment":""},{"DocComment":" Suppose `SubType` is a subtype of `SuperType`, that is,"},{"DocComment":" a value of type `SubType` can be used wherever"},{"DocComment":" a value of type `SuperType` is expected."},{"DocComment":" Suppose also that `CoVar<T>` is a generic type, which is covariant over `T`"},{"DocComment":" (like many other types, including `PhantomData<T>` and `Vec<T>`)."},{"DocComment":""},{"DocComment":" Then, by covariance, `CoVar<SubType>` is a subtype of `CoVar<SuperType>`,"},{"DocComment":" that is, a value of type `CoVar<SubType>` can be used wherever"},{"DocComment":" a value of type `CoVar<SuperType>` is expected."},{"DocComment":""},{"DocComment":" Then if `CoVar<SuperType>` relies on `TypeId::of::<SuperType>()` to uphold any invariants,"},{"DocComment":" those invariants may be broken because a value of type `CoVar<SuperType>` can be created"},{"DocComment":" without going through any of its methods, like so:"},{"DocComment":" ```"},{"DocComment":" type SubType = fn(&());"},{"DocComment":" type SuperType = fn(&'static ());"},{"DocComment":" type CoVar<T> = Vec<T>; // imagine something more complicated"},{"DocComment":""},{"DocComment":" let sub: CoVar<SubType> = CoVar::new();"},{"DocComment":" // we have a `CoVar<SuperType>` instance without"},{"DocComment":" // *ever* having called `CoVar::<SuperType>::new()`!"},{"DocComment":" let fake_super: CoVar<SuperType> = sub;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The following is an example program that tries to use `TypeId::of` to"},{"DocComment":" implement a generic type `Unique<T>` that guarantees unique instances for each `Unique<T>`,"},{"DocComment":" that is, for each type `T` there can be at most one value of type `Unique<T>` at any time."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" mod unique {"},{"DocComment":"     use std::any::TypeId;"},{"DocComment":"     use std::collections::BTreeSet;"},{"DocComment":"     use std::marker::PhantomData;"},{"DocComment":"     use std::sync::Mutex;"},{"DocComment":""},{"DocComment":"     static ID_SET: Mutex<BTreeSet<TypeId>> = Mutex::new(BTreeSet::new());"},{"DocComment":""},{"DocComment":"     // TypeId has only covariant uses, which makes Unique covariant over TypeAsId 🚨"},{"DocComment":"     #[derive(Debug, PartialEq)]"},{"DocComment":"     pub struct Unique<TypeAsId: 'static>("},{"DocComment":"         // private field prevents creation without `new` outside this module"},{"DocComment":"         PhantomData<TypeAsId>,"},{"DocComment":"     );"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Unique<TypeAsId> {"},{"DocComment":"         pub fn new() -> Option<Self> {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (set.insert(TypeId::of::<TypeAsId>())).then(|| Self(PhantomData))"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     impl<TypeAsId: 'static> Drop for Unique<TypeAsId> {"},{"DocComment":"         fn drop(&mut self) {"},{"DocComment":"             let mut set = ID_SET.lock().unwrap();"},{"DocComment":"             (!set.remove(&TypeId::of::<TypeAsId>())).then(|| panic!(\"duplicity detected\"));"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" use unique::Unique;"},{"DocComment":""},{"DocComment":" // `OtherRing` is a subtype of `TheOneRing`. Both are 'static, and thus have a TypeId."},{"DocComment":" type TheOneRing = fn(&'static ());"},{"DocComment":" type OtherRing = fn(&());"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let the_one_ring: Unique<TheOneRing> = Unique::new().unwrap();"},{"DocComment":"     assert_eq!(Unique::<TheOneRing>::new(), None);"},{"DocComment":""},{"DocComment":"     let other_ring: Unique<OtherRing> = Unique::new().unwrap();"},{"DocComment":"     // Use that `Unique<OtherRing>` is a subtype of `Unique<TheOneRing>` 🚨"},{"DocComment":"     let fake_one_ring: Unique<TheOneRing> = other_ring;"},{"DocComment":"     assert_eq!(fake_one_ring, the_one_ring);"},{"DocComment":""},{"DocComment":"     std::mem::forget(fake_one_ring);"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"type_id"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":16,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":39,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["error",0]},{"Ident":["Request",0]}],"span":{"data":{"file_id":18,"beg":{"line":588,"col":0},"end":{"line":588,"col":22}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Request` supports generic, type-driven access to data. Its use is currently restricted to the"},{"DocComment":" standard library in cases where trait authors wish to allow trait implementors to share generic"},{"DocComment":" information across trait boundaries. The motivating and prototypical use case is"},{"DocComment":" `core::error::Error` which would otherwise require a method per concrete type (e.g."},{"DocComment":" `std::backtrace::Backtrace` instance that implementors want to expose to users)."},{"DocComment":""},{"DocComment":" # Data flow"},{"DocComment":""},{"DocComment":" To describe the intended data flow for Request objects, let's consider two conceptual users"},{"DocComment":" separated by API boundaries:"},{"DocComment":""},{"DocComment":" * Consumer - the consumer requests objects using a Request instance; e.g. a crate that offers"},{"DocComment":"   fancy `Error`/`Result` reporting to users wants to request a Backtrace from a given `dyn Error`."},{"DocComment":""},{"DocComment":" * Producer - the producer provides objects when requested via Request; e.g. a library with an"},{"DocComment":"   an `Error` implementation that automatically captures backtraces at the time instances are"},{"DocComment":"   created."},{"DocComment":""},{"DocComment":" The consumer only needs to know where to submit their request and is expected to handle the"},{"DocComment":" request not being fulfilled by the use of `Option<T>` in the responses offered by the producer."},{"DocComment":""},{"DocComment":" * A Producer initializes the value of one of its fields of a specific type. (or is otherwise"},{"DocComment":"   prepared to generate a value requested). e.g., `backtrace::Backtrace` or"},{"DocComment":"   `std::backtrace::Backtrace`."},{"DocComment":" * A Consumer requests an object of a specific type (say `std::backtrace::Backtrace`). In the"},{"DocComment":"   case of a `dyn Error` trait object (the Producer), there are functions called `request_ref` and"},{"DocComment":"   `request_value` to simplify obtaining an `Option<T>` for a given type."},{"DocComment":" * The Producer, when requested, populates the given Request object which is given as a mutable"},{"DocComment":"   reference."},{"DocComment":" * The Consumer extracts a value or reference to the requested type from the `Request` object"},{"DocComment":"   wrapped in an `Option<T>`; in the case of `dyn Error` the aforementioned `request_ref` and"},{"DocComment":"   `request_value` methods mean that `dyn Error` users don't have to deal with the `Request` type at"},{"DocComment":"   all (but `Error` implementors do). The `None` case of the `Option` suggests only that the"},{"DocComment":"   Producer cannot currently offer an instance of the requested type, not that it can't or never will."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The best way to demonstrate this is using an example implementation of `Error`'s `provide` trait"},{"DocComment":" method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(error_generic_member_access)]"},{"DocComment":" use core::fmt;"},{"DocComment":" use core::error::Request;"},{"DocComment":" use core::error::request_ref;"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum MyLittleTeaPot {"},{"DocComment":"     Empty,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct MyBacktrace {"},{"DocComment":"     // ..."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl MyBacktrace {"},{"DocComment":"     fn new() -> MyBacktrace {"},{"DocComment":"         // ..."},{"DocComment":"         # MyBacktrace {}"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Error {"},{"DocComment":"     backtrace: MyBacktrace,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Display for Error {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Example Error\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl std::error::Error for Error {"},{"DocComment":"     fn provide<'a>(&'a self, request: &mut Request<'a>) {"},{"DocComment":"         request"},{"DocComment":"             .provide_ref::<MyBacktrace>(&self.backtrace);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let backtrace = MyBacktrace::new();"},{"DocComment":"     let error = Error { backtrace };"},{"DocComment":"     let dyn_error = &error as &dyn std::error::Error;"},{"DocComment":"     let backtrace_ref = request_ref::<MyBacktrace>(dyn_error).unwrap();"},{"DocComment":""},{"DocComment":"     assert!(core::ptr::eq(&error.backtrace, backtrace_ref));"},{"DocComment":"     assert!(request_ref::<MyLittleTeaPot>(dyn_error).is_none());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":"'a","mutability":"Shared"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":null,"align":null,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":40,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Ident":["String",0]}],"span":{"data":{"file_id":21,"beg":{"line":353,"col":0},"end":{"line":353,"col":17}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A UTF-8–encoded, growable string."},{"DocComment":""},{"DocComment":" `String` is the most common string type. It has ownership over the contents"},{"DocComment":" of the string, stored in a heap-allocated buffer (see [Representation](#representation))."},{"DocComment":" It is closely related to its borrowed counterpart, the primitive [`str`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" You can create a `String` from [a literal string][`&str`] with [`String::from`]:"},{"DocComment":""},{"DocComment":" [`String::from`]: From::from"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let hello = String::from(\"Hello, world!\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can append a [`char`] to a `String` with the [`push`] method, and"},{"DocComment":" append a [`&str`] with the [`push_str`] method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut hello = String::from(\"Hello, \");"},{"DocComment":""},{"DocComment":" hello.push('w');"},{"DocComment":" hello.push_str(\"orld!\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`push`]: String::push"},{"DocComment":" [`push_str`]: String::push_str"},{"DocComment":""},{"DocComment":" If you have a vector of UTF-8 bytes, you can create a `String` from it with"},{"DocComment":" the [`from_utf8`] method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We know these bytes are valid, so we'll use `unwrap()`."},{"DocComment":" let sparkle_heart = String::from_utf8(sparkle_heart).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`from_utf8`]: String::from_utf8"},{"DocComment":""},{"DocComment":" # UTF-8"},{"DocComment":""},{"DocComment":" `String`s are always valid UTF-8. If you need a non-UTF-8 string, consider"},{"DocComment":" [`OsString`]. It is similar, but without the UTF-8 constraint. Because UTF-8"},{"DocComment":" is a variable width encoding, `String`s are typically smaller than an array of"},{"DocComment":" the same `char`s:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // `s` is ASCII which represents each `char` as one byte"},{"DocComment":" let s = \"hello\";"},{"DocComment":" assert_eq!(s.len(), 5);"},{"DocComment":""},{"DocComment":" // A `char` array with the same contents would be longer because"},{"DocComment":" // every `char` is four bytes"},{"DocComment":" let s = ['h', 'e', 'l', 'l', 'o'];"},{"DocComment":" let size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();"},{"DocComment":" assert_eq!(size, 20);"},{"DocComment":""},{"DocComment":" // However, for non-ASCII strings, the difference will be smaller"},{"DocComment":" // and sometimes they are the same"},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" assert_eq!(s.len(), 20);"},{"DocComment":""},{"DocComment":" let s = ['💖', '💖', '💖', '💖', '💖'];"},{"DocComment":" let size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();"},{"DocComment":" assert_eq!(size, 20);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This raises interesting questions as to how `s[i]` should work."},{"DocComment":" What should `i` be here? Several options include byte indices and"},{"DocComment":" `char` indices but, because of UTF-8 encoding, only byte indices"},{"DocComment":" would provide constant time indexing. Getting the `i`th `char`, for"},{"DocComment":" example, is available using [`chars`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = \"hello\";"},{"DocComment":" let third_character = s.chars().nth(2);"},{"DocComment":" assert_eq!(third_character, Some('l'));"},{"DocComment":""},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" let third_character = s.chars().nth(2);"},{"DocComment":" assert_eq!(third_character, Some('💖'));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Next, what should `s[i]` return? Because indexing returns a reference"},{"DocComment":" to underlying data it could be `&u8`, `&[u8]`, or something similar."},{"DocComment":" Since we're only providing one index, `&u8` makes the most sense but that"},{"DocComment":" might not be what the user expects and can be explicitly achieved with"},{"DocComment":" [`as_bytes()`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // The first byte is 104 - the byte value of `'h'`"},{"DocComment":" let s = \"hello\";"},{"DocComment":" assert_eq!(s.as_bytes()[0], 104);"},{"DocComment":" // or"},{"DocComment":" assert_eq!(s.as_bytes()[0], b'h');"},{"DocComment":""},{"DocComment":" // The first byte is 240 which isn't obviously useful"},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" assert_eq!(s.as_bytes()[0], 240);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Due to these ambiguities/restrictions, indexing with a `usize` is simply"},{"DocComment":" forbidden:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" let s = \"hello\";"},{"DocComment":""},{"DocComment":" // The following will not compile!"},{"DocComment":" println!(\"The first letter of s is {}\", s[0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It is more clear, however, how `&s[i..j]` should work (that is,"},{"DocComment":" indexing with a range). It should accept byte indices (to be constant-time)"},{"DocComment":" and return a `&str` which is UTF-8 encoded. This is also called \"string slicing\"."},{"DocComment":" Note this will panic if the byte indices provided are not character"},{"DocComment":" boundaries - see [`is_char_boundary`] for more details. See the implementations"},{"DocComment":" for [`SliceIndex<str>`] for more details on string slicing. For a non-panicking"},{"DocComment":" version of string slicing, see [`get`]."},{"DocComment":""},{"DocComment":" [`OsString`]: ../../std/ffi/struct.OsString.html \"ffi::OsString\""},{"DocComment":" [`SliceIndex<str>`]: core::slice::SliceIndex"},{"DocComment":" [`as_bytes()`]: str::as_bytes"},{"DocComment":" [`get`]: str::get"},{"DocComment":" [`is_char_boundary`]: str::is_char_boundary"},{"DocComment":""},{"DocComment":" The [`bytes`] and [`chars`] methods return iterators over the bytes and"},{"DocComment":" codepoints of the string, respectively. To iterate over codepoints along"},{"DocComment":" with byte indices, use [`char_indices`]."},{"DocComment":""},{"DocComment":" [`bytes`]: str::bytes"},{"DocComment":" [`chars`]: str::chars"},{"DocComment":" [`char_indices`]: str::char_indices"},{"DocComment":""},{"DocComment":" # Deref"},{"DocComment":""},{"DocComment":" `String` implements <code>[Deref]<Target = [str]></code>, and so inherits all of [`str`]'s"},{"DocComment":" methods. In addition, this means that you can pass a `String` to a"},{"DocComment":" function which takes a [`&str`] by using an ampersand (`&`):"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn takes_str(s: &str) { }"},{"DocComment":""},{"DocComment":" let s = String::from(\"Hello\");"},{"DocComment":""},{"DocComment":" takes_str(&s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will create a [`&str`] from the `String` and pass it in. This"},{"DocComment":" conversion is very inexpensive, and so generally, functions will accept"},{"DocComment":" [`&str`]s as arguments unless they need a `String` for some specific"},{"DocComment":" reason."},{"DocComment":""},{"DocComment":" In certain cases Rust doesn't have enough information to make this"},{"DocComment":" conversion, known as [`Deref`] coercion. In the following example a string"},{"DocComment":" slice [`&'a str`][`&str`] implements the trait `TraitExample`, and the function"},{"DocComment":" `example_func` takes anything that implements the trait. In this case Rust"},{"DocComment":" would need to make two implicit conversions, which Rust doesn't have the"},{"DocComment":" means to do. For that reason, the following example will not compile."},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" trait TraitExample {}"},{"DocComment":""},{"DocComment":" impl<'a> TraitExample for &'a str {}"},{"DocComment":""},{"DocComment":" fn example_func<A: TraitExample>(example_arg: A) {}"},{"DocComment":""},{"DocComment":" let example_string = String::from(\"example_string\");"},{"DocComment":" example_func(&example_string);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are two options that would work instead. The first would be to"},{"DocComment":" change the line `example_func(&example_string);` to"},{"DocComment":" `example_func(example_string.as_str());`, using the method [`as_str()`]"},{"DocComment":" to explicitly extract the string slice containing the string. The second"},{"DocComment":" way changes `example_func(&example_string);` to"},{"DocComment":" `example_func(&*example_string);`. In this case we are dereferencing a"},{"DocComment":" `String` to a [`str`], then referencing the [`str`] back to"},{"DocComment":" [`&str`]. The second way is more idiomatic, however both work to do the"},{"DocComment":" conversion explicitly rather than relying on the implicit conversion."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" A `String` is made up of three components: a pointer to some bytes, a"},{"DocComment":" length, and a capacity. The pointer points to the internal buffer which `String`"},{"DocComment":" uses to store its data. The length is the number of bytes currently stored"},{"DocComment":" in the buffer, and the capacity is the size of the buffer in bytes. As such,"},{"DocComment":" the length will always be less than or equal to the capacity."},{"DocComment":""},{"DocComment":" This buffer is always stored on the heap."},{"DocComment":""},{"DocComment":" You can look at these with the [`as_ptr`], [`len`], and [`capacity`]"},{"DocComment":" methods:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let story = String::from(\"Once upon a time...\");"},{"DocComment":""},{"DocComment":" // Deconstruct the String into parts."},{"DocComment":" let (ptr, len, capacity) = story.into_raw_parts();"},{"DocComment":""},{"DocComment":" // story has nineteen bytes"},{"DocComment":" assert_eq!(19, len);"},{"DocComment":""},{"DocComment":" // We can re-build a String out of ptr, len, and capacity. This is all"},{"DocComment":" // unsafe because we are responsible for making sure the components are"},{"DocComment":" // valid:"},{"DocComment":" let s = unsafe { String::from_raw_parts(ptr, len, capacity) } ;"},{"DocComment":""},{"DocComment":" assert_eq!(String::from(\"Once upon a time...\"), s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`as_ptr`]: str::as_ptr"},{"DocComment":" [`len`]: String::len"},{"DocComment":" [`capacity`]: String::capacity"},{"DocComment":""},{"DocComment":" If a `String` has enough capacity, adding elements to it will not"},{"DocComment":" re-allocate. For example, consider this program:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::new();"},{"DocComment":""},{"DocComment":" println!(\"{}\", s.capacity());"},{"DocComment":""},{"DocComment":" for _ in 0..5 {"},{"DocComment":"     s.push_str(\"hello\");"},{"DocComment":"     println!(\"{}\", s.capacity());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will output the following:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 0"},{"DocComment":" 8"},{"DocComment":" 16"},{"DocComment":" 16"},{"DocComment":" 32"},{"DocComment":" 32"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" At first, we have no memory allocated at all, but as we append to the"},{"DocComment":" string, it increases its capacity appropriately. If we instead use the"},{"DocComment":" [`with_capacity`] method to allocate the correct capacity initially:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::with_capacity(25);"},{"DocComment":""},{"DocComment":" println!(\"{}\", s.capacity());"},{"DocComment":""},{"DocComment":" for _ in 0..5 {"},{"DocComment":"     s.push_str(\"hello\");"},{"DocComment":"     println!(\"{}\", s.capacity());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`with_capacity`]: String::with_capacity"},{"DocComment":""},{"DocComment":" We end up with a different output:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here, there's no need to allocate more memory inside the loop."},{"DocComment":""},{"DocComment":" [str]: prim@str \"str\""},{"DocComment":" [`str`]: prim@str \"str\""},{"DocComment":" [`&str`]: prim@str \"&str\""},{"DocComment":" [Deref]: core::ops::Deref \"ops::Deref\""},{"DocComment":" [`Deref`]: core::ops::Deref \"ops::Deref\""},{"DocComment":" [`as_str()`]: String::as_str"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"String"},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":24,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":false}}}],"ptr_metadata":"None"},{"def_id":41,"item_meta":{"name":[{"Ident":["spqr",0]},{"Ident":["proto",0]},{"Ident":["pq_ratchet",0]},{"Ident":["pq_ratchet_state",0]},{"Ident":["Inner",0]}],"span":{"data":{"file_id":13,"beg":{"line":50,"col":4},"end":{"line":53,"col":5}},"generated_from_span":null},"source_text":"pub enum Inner {\n        #[prost(message, tag = \"3\")]\n        V1(super::V1State),\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Enum":[{"id":0,"span":{"data":{"file_id":13,"beg":{"line":52,"col":8},"end":{"line":52,"col":10}},"generated_from_span":null},"attr_info":{"attributes":[{"Unknown":{"path":"prost","args":"message, tag = \"3\""}}],"inline":null,"rename":null,"public":true},"name":"V1","fields":[{"span":{"data":{"file_id":13,"beg":{"line":52,"col":11},"end":{"line":52,"col":25}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":null,"ty":{"HashConsedValue":[1770,{"Adt":{"id":{"Adt":42},"generics":{"regions":[],"types":[],"cons