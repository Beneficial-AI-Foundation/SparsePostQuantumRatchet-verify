r"},{"DocComment":" function that is documented to change the `BufMut`'s current position."},{"DocComment":""},{"DocComment":" # Note"},{"DocComment":""},{"DocComment":" `remaining_mut` may return value smaller than actual available space."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":26,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":40380}],"output":{"Deduplicated":2971}},"src":{"TraitDecl":{"trait_ref":{"id":26,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}},"item_id":{"Method":0},"has_default":false}},"is_global_initializer":null,"body":"Opaque"},{"def_id":813,"item_meta":{"name":[{"Ident":["bytes",0]},{"Ident":["buf",0]},{"Ident":["buf_mut",0]},{"Ident":["BufMut",0]},{"Ident":["advance_mut",0]}],"span":{"data":{"file_id":79,"beg":{"line":107,"col":4},"end":{"line":107,"col":49}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advance the internal cursor of the BufMut"},{"DocComment":""},{"DocComment":" The next call to `chunk_mut` will return a slice starting `cnt` bytes"},{"DocComment":" further into the underlying buffer."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" The caller must ensure that the next `cnt` bytes of `chunk` are"},{"DocComment":" initialized."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use bytes::BufMut;"},{"DocComment":""},{"DocComment":" let mut buf = Vec::with_capacity(16);"},{"DocComment":""},{"DocComment":" // Write some data"},{"DocComment":" buf.chunk_mut()[0..2].copy_from_slice(b\"he\");"},{"DocComment":" unsafe { buf.advance_mut(2) };"},{"DocComment":""},{"DocComment":" // write more bytes"},{"DocComment":" buf.chunk_mut()[0..3].copy_from_slice(b\"llo\");"},{"DocComment":""},{"DocComment":" unsafe { buf.advance_mut(3); }"},{"DocComment":""},{"DocComment":" assert_eq!(5, buf.len());"},{"DocComment":" assert_eq!(buf, b\"hello\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function **may** panic if `cnt > self.remaining_mut()`."},{"DocComment":""},{"DocComment":" # Implementer notes"},{"DocComment":""},{"DocComment":" It is recommended for implementations of `advance_mut` to panic if"},{"DocComment":" `cnt > self.remaining_mut()`. If the implementation does not panic,"},{"DocComment":" the call must behave as if `cnt == self.remaining_mut()`."},{"DocComment":""},{"DocComment":" A call with `cnt == 0` should never panic and be a no-op."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":26,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","inputs":[{"Deduplicated":40691},{"Deduplicated":2971}],"output":{"Deduplicated":1645}},"src":{"TraitDecl":{"trait_ref":{"id":26,"generics":{"regions":[],"types":[{"Deduplicated":40277}],"const_generics":[],"tra