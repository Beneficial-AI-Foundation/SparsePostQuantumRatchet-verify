module
public import SrcTranslated.FunsExternal
public import Spqr.Crypto.Fips203.Bridge.EncapsBytes
public import Spqr.Crypto.Fips203.Bridge.LibcruxEncaps1
/-!
# Bridge: FIPS 203 Algorithm 17 (round 2) ↔ libcrux `incremental::encapsulate2`

The Aeneas external
`libcrux_ml_kem.mlkem768.incremental.encapsulate2` is modelled in `SrcTranslated/FunsExternal.lean`
by round 2 of `ML-KEM.Encaps_internal` (`Fips203.mlkemEncapsPhase2`, see
`Spqr/Crypto/Fips203/KEM/EncapsIncremental.lean`) on the state `(ŷ, e₂, m)` decoded from the
2080-byte buffer written by round 1 and the NTT-domain vector `t̂` decoded from the 1152-byte
`pk2 = ByteEncode₁₂(t̂)`.

This file states the bridge as equations between the Aeneas side and the FIPS 203 definitions:

| libcrux output | FIPS 203 value                                                         |
|----------------|------------------------------------------------------------------------|
| `ct2.value`    | `c₂ = mlkemEncapsPhase2 (decodeEncapsState state) (decodePk2THat pk2)` |

and, when `state` is the buffer written by `encapsulate1` on the header `pk1` of a key pair
produced by `from_seed` (Bridges 6.1/6.2) and `pk2` is that key's serialised `t̂`, connects the
output to the *monolithic* Algorithm 17 on that key's `ek`:
`c₂ = (mlkemEncaps ek m).ct[960 : 1088]`, completing `ct = c₁ ‖ c₂`.

**Sources**: NIST FIPS 203, § 6.2 (Algorithm 17); libcrux-ml-kem 0.0.7, `src/mlkem.rs` lines
400–412 and `src/ind_cca/incremental.rs` lines 278–319.
-/

@[expose] public section

noncomputable section

open Aeneas Aeneas.Std Result

namespace Fips203.Bridge

open libcrux_ml_kem.mlkem768.incremental

/-! ## Byte vectors as fixed-size Aeneas arrays -/

/-- A 2080-byte state vector as an Aeneas `Array U8 2080`. -/
def stateArray (b : Fin encapsStateSize → UInt8) : Array U8 2080#usize :=
  Aeneas.Std.Array.make 2080#usize (toU8List b) (toU8List_length b)

/-- An 1152-byte `pk2` vector as an Aeneas `Array U8 1152`. -/
def pk2Array (b : Fin 1152 → UInt8) : Array U8 1152#usize :=
  Aeneas.Std.Array.make 1152#usize (toU8List b) (toU8List_length b)

/-- Reading back the bytes of `stateArray` recovers the vector. -/
theorem stateOfArray_stateArray (b : Fin encapsStateSize → UInt8) :
    stateOfArray (stateArray b) = b := by
  funext i
  simp only [stateOfArray, stateArray, Aeneas.Std.Array.make_val]
  rw [toU8List_getElem, U8.toUInt8_ofUInt8]

/-- Reading back the bytes of `pk2Array` recovers the vector. -/
theorem pk2OfArray_pk2Array (b : Fin 1152 → UInt8) : pk2OfArray (pk2Array b) = b := by
  funext i
  simp only [pk2OfArray, pk2Array, Aeneas.Std.Array.make_val]
  rw [toU8List_getElem, U8.toUInt8_ofUInt8]

/-! ## `encapsulate2` ↔ round 2 of Algorithm 17 -/

/-- **Bridge 6.3.**  `encapsulate2` returns, without failure, the `128`-byte `c₂` of round 2 of
Algorithm 17 on the decoded state and the decoded `t̂`. -/
theorem encapsulate2_eq_mlkemEncapsPhase2 (state : Array U8 2080#usize)
    (pk2 : Array U8 1152#usize) :
    encapsulate2 state pk2 = ok { value := ct2Array state pk2 } := rfl

/-- The returned ciphertext half, as a byte list, is `c₂`. -/
theorem encapsulate2_ct2 (state : Array U8 2080#usize) (pk2 : Array U8 1152#usize)
    (c : spqr.libcrux_ml_kem.ind_cca.incremental.types.Ciphertext2 128#usize)
    (h : encapsulate2 state pk2 = ok c) :
    c.value.val = ct2List state pk2 := by
  rw [encapsulate2_eq_mlkemEncapsPhase2, ok.injEq] at h
  rw [← h]
  rfl

/-- On the serialised round-1 state and an arbitrary `pk2`, `ct2Bytes` is round 2 of
Algorithm 17 on the round-1 state `(ŷ, e₂, m)` and the decoded `t̂`. -/
theorem ct2Bytes_stateArray (st : EncapsState mlkem768) (pk2 : Fin 1152 → UInt8)
    (i : Fin ct2Size) :
    ct2Bytes (stateArray (stateBytes st)) (pk2Array pk2) i =
      mlkemEncapsPhase2 mlkem768 st (decodePk2THat pk2) ⟨i.val, by
        have := i.isLt; rw [ct2Size_eq]; exact this⟩ := by
  simp only [ct2Bytes, stateOfArray_stateArray, pk2OfArray_pk2Array,
    decodeEncapsState_stateBytes]

/-! ## Composition with Bridges 6.1 and 6.2

When `state` is the buffer written by `encapsulate1` on the header `pk1Bytes seed` of a key pair
generated by `from_seed seed` (Bridges 6.1/6.2) and `pk2 = pk2Bytes seed` is that key's
serialised `t̂`, round 2 produces `ct[960 : 1088]` of the monolithic
`ML-KEM.Encaps_internal(ek, m)`. -/

/-- `c₂` on a generated key's round-1 state and `pk2` is `ct[960 + i]` of Algorithm 17 on its
`ek`. -/
theorem ct2Bytes_stateOut_pk2Bytes (seed : Fin 64 → UInt8)
    (h : 64 ≤ (toU8List (pk1Bytes seed)).length) (m : Fin 32 → UInt8) (i : Fin ct2Size) :
    ct2Bytes (stateArray (stateOut (toU8List (pk1Bytes seed)) h m)) (pk2Array (pk2Bytes seed)) i =
      (mlkemEncaps mlkem768 (ekBytes seed) m).ct ⟨960 + i.val, by
        have := i.isLt; simp only [ct2Size] at this
        rw [ctSizeEnc_eq_ctSize, mlkem768_ctSize]; omega⟩ := by
  rw [stateOut, ct2Bytes_stateArray, decodePk2THat_pk2Bytes, encaps1Output_pk1Bytes,
    mlkemEncapsPhase2_ct2]
  exact congrArg _ (Fin.ext (by simp only [mlkem768CompressionU, mlkem768_k]))

/-- The full composition of the three bridges: `ct1Bytes ‖ ct2Bytes` on a generated key is
byte-for-byte the ciphertext of Algorithm 17 on its `ek`. -/
theorem ct_eq_ct1Bytes_append_ct2Bytes (seed : Fin 64 → UInt8)
    (h : 64 ≤ (toU8List (pk1Bytes seed)).length) (m : Fin 32 → UInt8)
    (idx : Fin mlkem768.ctSizeEnc) :
    (mlkemEncaps mlkem768 (ekBytes seed) m).ct idx =
      if hlt : idx.val < ct1Size then
        ct1Bytes (toU8List (pk1Bytes seed)) h m ⟨idx.val, hlt⟩
      else
        ct2Bytes (stateArray (stateOut (toU8List (pk1Bytes seed)) h m))
          (pk2Array (pk2Bytes seed)) ⟨idx.val - ct1Size, by
            have := idx.isLt
            simp only [ParamSet.ctSizeEnc, mlkem768CompressionU,
            mlkem768CompressionV, mlkem768_k] at this
            simp only [ct1Size, ct2Size]; omega⟩ := by
  by_cases hlt : idx.val < ct1Size
  · rw [dif_pos hlt, ct1Bytes_pk1Bytes]
  · rw [dif_neg hlt, ct2Bytes_stateOut_pk2Bytes]
    refine congrArg _ (Fin.ext ?_)
    simp only [ct1Size] at hlt ⊢
    omega

end Fips203.Bridge
