module
public import SrcTranslated.Funs
public import SrcTranslated.FunsExternal
public import Spqr.Crypto.Fips203.Bridge.LibcruxDecaps
public import Spqr.Specs.Aeneas.ResultExpect
public import Spqr.Specs.IncrementalMlkem768.Encaps2
/-! # Spec theorem for `incremental_mlkem768::decaps`

`decaps` is ML-KEM-768 decapsulation packaged for the SPQR ratchet: given the 2400-byte
compressed key-pair buffer `dk = dkPKE ‖ ek ‖ H(ek) ‖ z` produced by `generate`, the 960-byte
first ciphertext half `c₁` and the 128-byte second half `c₂`, it returns the 32-byte shared
secret.

The extracted body in `SrcTranslated/Funs.lean` proceeds in three steps:
* `try_into` the three input `Vec`s into fixed-size arrays of 960, 128 and 2400 bytes and unwrap
  the `Result`s (`expect`) — with the length preconditions these cannot fail;
* call libcrux's incremental `decapsulate_compressed_key`;
* copy the shared secret into an owned `Vec`.

**FIPS 203 value semantics** (Phase 7.4 of `doc/plan.md`, via Bridge 6.4
`Spqr/Crypto/Fips203/Bridge/LibcruxDecaps.lean`): the output is
`Fips203.Bridge.ssList dk' ct1' ct2'` — `ML-KEM.Decaps_internal(dk, c₁ ‖ c₂)`
(`Fips203.mlkemDecaps`, FIPS 203 Algorithm 18) on the decapsulation key read from the key-pair
buffer and the reassembled ciphertext — where `dk'`, `ct1'`, `ct2'` hold the bytes of the three
inputs.

When `dk` is the buffer of a key pair generated by `generate` (Phase 7.1) and `c₁`/`c₂` come from
`encaps1`/`encaps2` on that key (Phases 7.2–7.3), `ssBytes_roundTrip` of Bridge 6.4 identifies
the output with the shared secret of the monolithic `ML-KEM.Encaps_internal(ek, m)` under the
K-PKE noise bound.

**Source**: `src/incremental_mlkem768.rs`, lines 156:0-169:1 -/

@[expose] public section

open Aeneas Aeneas.Std Result

namespace spqr.incremental_mlkem768

open libcrux_ml_kem.mlkem768.incremental

/-- **Spec theorem for `incremental_mlkem768.decaps`**:

Assuming the Rust `requires` (`dk.len() = 2400`, `ct1.len() = 960`, `ct2.len() = 128`), `decaps`
succeeds and returns the 32-byte shared secret of FIPS 203 Algorithm 18 (Bridge 6.4): there are
fixed-size arrays `dk'`, `ct1'`, `ct2'` holding the bytes of the three inputs with
`result = Fips203.Bridge.ssList dk' ct1' ct2'`, i.e. the secret of
`ML-KEM.Decaps_internal(dk, c₁ ‖ c₂)` — the re-encryption check returns the decrypted secret
`K'` or the implicit-rejection key `J(z ‖ c)`. -/
theorem decaps_spec (dk ct1 ct2 : alloc.vec.Vec Std.U8)
    (h_dk : dk.length = 2400) (h_ct1 : ct1.length = 960) (h_ct2 : ct2.length = 128) :
    decaps dk ct1 ct2 ⦃ (result : alloc.vec.Vec Std.U8) =>
      (∃ (dk' : Array Std.U8 2400#usize) (ct1' : Array Std.U8 960#usize)
          (ct2' : Array Std.U8 128#usize),
        dk'.val = dk.val ∧ ct1'.val = ct1.val ∧ ct2'.val = ct2.val ∧
        result.val = Fips203.Bridge.ssList dk' ct1' ct2') ∧
      result.length = 32 ⦄ := by
  unfold decaps
  step*
  -- `try_from` on `ct1` cannot fail: by `h_ct1` the slice has exactly 960 bytes.
  obtain ⟨ct1', h_r, h_ct1_val⟩ : ∃ a, r = .Ok a ∧ a.val = s.val := by
    cases r with
    | Ok a => exact ⟨a, rfl, r_post.1⟩
    | Err e => exact absurd (by simp only [Slice.length, s_post]; exact h_ct1) r_post
  rw [h_r]
  -- Unwrap the `expect` on the `Ok` `ct1` array and continue to the second `try_from`.
  step*
  -- `try_from` on `ct2` cannot fail: by `h_ct2` the slice has exactly 128 bytes.
  obtain ⟨ct2', h_r1, h_ct2_val⟩ : ∃ a, r1 = .Ok a ∧ a.val = s1.val := by
    cases r1 with
    | Ok a => exact ⟨a, rfl, r1_post.1⟩
    | Err e => exact absurd (by simp only [Slice.length, s1_post]; exact h_ct2) r1_post
  rw [h_r1]
  -- Unwrap the `expect` on the `Ok` `ct2` array and continue to the third `try_from` — the
  -- shared-reference variant, whose `@[step]` spec (`tryFromSharedArraySlice_ok_spec`, stated in
  -- `Encaps2.lean`) discharges the 2400-byte length side goal from `h_dk` via `scalar_tac`.
  step*
  -- `step*` already destructured the `Ok` result into the key-pair array `a` with
  -- `r2_post : r2 = .Ok a` and `r2_post1 : a.val = s2.val`. Unwrap the `expect` on it, run
  -- `decapsulate_compressed_key` (Bridge 6.4) and copy the shared-secret bytes into an owned
  -- `Vec`.
  rw [r2_post]
  step*
  -- `step*` leaves `s3 = a3.to_slice` (shadowed, so recover it with `rename_i`) and
  -- `s3_post : s3 = result.slice`; `result.val` unfolds to `result.slice.val`.
  rename_i h_s3_to_slice
  have h_result : result.val = a3.val := by
    simp only [alloc.vec.Vec.val, ← s3_post, h_s3_to_slice, Array.val_to_slice]
  refine ⟨⟨a, ct1', ct2', ?_, ?_, ?_, ?_⟩, ?_⟩
  · rw [r2_post1, s2_post]
  · rw [h_ct1_val, s_post]
  · rw [h_ct2_val, s1_post]
  · simp only [h_result, a3_post1, a2_post, a_post, a1_post]
  · simp only [alloc.vec.Vec.length, h_result, a3_post1, Fips203.Bridge.ssList_length]

end spqr.incremental_mlkem768
