import SrcTranslated.Funs
import SrcTranslated.FunsExternal
import Spqr.Crypto.Fips203.Bridge.LibcruxEncaps1
import Spqr.Specs.Aeneas.ResultExpect

/-! # Spec theorem for `incremental_mlkem768::encaps1`

`encaps1` is round 1 of ML-KEM-768 encapsulation packaged for the SPQR ratchet: given the
64-byte header `hdr = ρ ‖ H(ek)` of a peer's key pair, it samples a fresh 32-byte message from a
cryptographically secure RNG, runs libcrux's incremental `encapsulate1`, and returns the three
buffers `(ct1, es, ss)` — the 960-byte first ciphertext half, the 2080-byte serialized
encapsulation state (consumed later by `encaps2`), and the 32-byte shared secret.

The extracted body in `SrcTranslated/Funs.lean` proceeds in four steps:
* allocate a 32-byte zero buffer and overwrite it via `RngCore::fill_bytes` — the fresh message;
* allocate the two zeroed output buffers of lengths `encaps_state_len() = 2080` and
  `SHARED_SECRET_SIZE = 32`;
* call `incremental::encapsulate1(hdr, randomness, &mut state, &mut ss)` and unwrap the returned
  `Result` (`expect`) — with `hdr.len() ≥ 64` and the exact output sizes this cannot fail;
* copy the ciphertext into an owned `Vec` and return `(ct1, state, ss)`.

**FIPS 203 value semantics** (Phase 7.2 of `doc/plan.md`, via Bridge 6.2
`Spqr/Crypto/Fips203/Bridge/LibcruxEncaps1.lean`): there is a 32-byte message `m` (the one
`fill_bytes` wrote) such that, writing `(K, c₁, (ŷ, e₂, m)) = mlkemEncapsPhase1 (ρ, h) m`
(round 1 of FIPS 203 Algorithm 17) for the header `(ρ, h) = (hdr[0:32], hdr[32:64])`:
* `ct1` = `Fips203.Bridge.ct1List hdr m`   — the serialised `c₁`;
* `es`  = `Fips203.Bridge.stateOut hdr m`  — the serialised state `ŷ ‖ e₂ ‖ m`;
* `ss`  = `Fips203.Bridge.ssOut hdr m`     — the shared secret `K`.

When `hdr` is the header of a key pair generated by `generate` (`pk1Bytes seed`, Phase 7.1),
`ssOut_pk1Bytes` and `ct1Bytes_pk1Bytes` of Bridge 6.2 identify these values with the monolithic
`ML-KEM.Encaps_internal(ek, m)` on that key's `ek`.

Remaining future work (not expressible at this layer): distributional faithfulness of the message
(uniformity of `fill_bytes`) and game-based IND-CCA2 security.

**Source**: `src/incremental_mlkem768.rs`, lines 48:0-66:1 -/

open Aeneas Aeneas.Std Result

namespace Fips203.Bridge

/-- Overwriting the first `N` bytes of a list of length exactly `N` replaces it entirely. -/
theorem overwritePrefix_of_length_eq {N : ℕ} (l : List U8) (b : Fin N → UInt8)
    (h : l.length = N) : overwritePrefix l b = toU8List b := by
  simp only [overwritePrefix, List.drop_eq_nil_of_le (Nat.le_of_eq h), List.append_nil]

/-- `ct1List` only depends on the header bytes (the length proof is irrelevant). -/
theorem ct1List_congr {pk1 pk1' : List U8} (hp : pk1 = pk1') (h : 64 ≤ pk1.length)
    (h' : 64 ≤ pk1'.length) (m : Fin 32 → UInt8) :
    ct1List pk1 h m = ct1List pk1' h' m := by subst hp; rfl

/-- `stateOut` only depends on the header bytes (the length proof is irrelevant). -/
theorem stateOut_congr {pk1 pk1' : List U8} (hp : pk1 = pk1') (h : 64 ≤ pk1.length)
    (h' : 64 ≤ pk1'.length) (m : Fin 32 → UInt8) :
    stateOut pk1 h m = stateOut pk1' h' m := by subst hp; rfl

/-- `ssOut` only depends on the header bytes (the length proof is irrelevant). -/
theorem ssOut_congr {pk1 pk1' : List U8} (hp : pk1 = pk1') (h : 64 ≤ pk1.length)
    (h' : 64 ≤ pk1'.length) (m : Fin 32 → UInt8) :
    ssOut pk1 h m = ssOut pk1' h' m := by subst hp; rfl

end Fips203.Bridge

namespace spqr.incremental_mlkem768

open libcrux_ml_kem.mlkem768.incremental

/-- **Spec theorem for `incremental_mlkem768.encaps1`**:

Assuming `fill_bytes` is panic-free and `64 ≤ hdr.len()` (the Rust precondition is
`hdr.len() == 64`), `encaps1` returns `((ct1, es, ss), rng)` where there is a 32-byte message `m`
(the one `fill_bytes` wrote) such that, with `(K, c₁, (ŷ, e₂, m)) = mlkemEncapsPhase1 (ρ, h) m`
for the header `(ρ, h) = (hdr[0:32], hdr[32:64])` (round 1 of FIPS 203 Algorithm 17, Bridge 6.2):
* `ct1` = `Fips203.Bridge.ct1List hdr m` — the serialised first ciphertext half `c₁`
  (length `960`);
* `es`  = `Fips203.Bridge.stateOut hdr m` — the serialised state `ŷ ‖ e₂ ‖ m` (length `2080`);
* `ss`  = `Fips203.Bridge.ssOut hdr m` — the shared secret `K` (length `32`). -/
theorem encaps1_spec {R : Type} (rngInst : rand.rng.Rng R)
    (cryptoInst : rand_core.CryptoRng R) (hdr : alloc.vec.Vec Std.U8) (rng : R)
    (h_hdr : 64 ≤ hdr.val.length)
    (h_fill : ∀ (r : R) (s : Slice Std.U8),
      rngInst.rand_coreRngCoreInst.fill_bytes r s ⦃ fun _ => True ⦄) :
    encaps1 rngInst cryptoInst hdr rng ⦃ (result :
        ((alloc.vec.Vec Std.U8) × (alloc.vec.Vec Std.U8) × (alloc.vec.Vec Std.U8)) × R) =>
      (∃ m : Fin 32 → UInt8,
        result.1.1.val = Fips203.Bridge.ct1List hdr.val h_hdr m ∧
        result.1.2.1.val =
          Fips203.Bridge.toU8List (Fips203.Bridge.stateOut hdr.val h_hdr m) ∧
        result.1.2.2.val =
          Fips203.Bridge.toU8List (Fips203.Bridge.ssOut hdr.val h_hdr m)) ∧
      result.1.1.length = 960 ∧
      result.1.2.1.length = Fips203.Bridge.encapsStateSize ∧
      result.1.2.2.length = Fips203.Bridge.sharedSecretSize ⦄ := by
  unfold encaps1
  step*
  -- Reduce the two `deref_mut` views of the output buffers to their underlying slices.
  simp only [alloc.vec.Vec.deref_mut, lift, bind_tc_ok]
  -- Length facts needed by Bridge 6.2.
  have h_s2 : 64 ≤ s2.length := by simp only [Slice.length, s2_post]; exact h_hdr
  have h_state : Fips203.Bridge.encapsStateSize ≤
      Slice.length (⟨state.val, state.property⟩ : Slice U8) := by
    simp only [Slice.length]; scalar_tac
  have h_ss : (32 : ℕ) ≤ Slice.length (⟨ss.val, ss.property⟩ : Slice U8) := by
    simp only [Slice.length]; scalar_tac
  -- Bridge 6.2: `encapsulate1_spec` (a `@[step]` theorem) gives the FIPS 203 values of the
  -- three outputs.
  step*
  -- Unwrap the `expect` on the `Ok` ciphertext and copy it into an owned `Vec`.
  subst ct1_post1
  step*
  -- Lengths of the output buffers: both were allocated with exactly the written sizes, so the
  -- untouched suffixes are empty and each buffer equals the FIPS 203 value byte-for-byte.
  have h_state_len : state.val.length = Fips203.Bridge.encapsStateSize := by
    simp only [state_post1, List.length_replicate]; exact i_post
  have h_ss_len : ss.val.length = (32 : ℕ) := by
    simp only [ss_post1, List.length_replicate]; exact i1_post
  have h_hdr' : (64 : ℕ) ≤ s2.val.length := h_s2
  refine ⟨⟨Fips203.Bridge.msgOfArray (to_slice_mut_back s1), ?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  · rw [← v_post, c_post, Array.val_to_slice, Fips203.Bridge.ct1Array, Array.val_make]
    exact Fips203.Bridge.ct1List_congr s2_post h_hdr' h_hdr _
  · rw [ct1_post2, Fips203.Bridge.overwritePrefix_of_length_eq _ _ h_state_len,
      Fips203.Bridge.stateOut_congr s2_post h_hdr' h_hdr]
  · rw [ct1_post3, Fips203.Bridge.overwritePrefix_of_length_eq _ _ h_ss_len,
      Fips203.Bridge.ssOut_congr s2_post h_hdr' h_hdr]
  · rw [alloc.vec.Vec.length, ← v_post, c_post, Array.val_to_slice, Fips203.Bridge.ct1Array,
      Array.val_make, Fips203.Bridge.ct1List_length]
  · rw [alloc.vec.Vec.length, ct1_post2,
      Fips203.Bridge.overwritePrefix_length _ _ (le_of_eq h_state_len.symm), h_state_len]
  · rw [alloc.vec.Vec.length, ct1_post3,
      Fips203.Bridge.overwritePrefix_length _ _ (le_of_eq h_ss_len.symm), h_ss_len]
    rfl

end spqr.incremental_mlkem768
